---
import PostLayout from "@/layouts/PostLayout.astro";
import { getStrapiClient } from "@/services/strapiClientService";
import { renderStrapiMarkdown } from "@/utils/markdownParser";

export const prerender = false;

const { slug } = Astro.params;
const client = getStrapiClient();
const response = await client.collection("articles").find({
  populate: "*",
  filters: {
    slug: {
      $eq: slug,
    },
  },
});

const article = response.data[0];
const html = await renderStrapiMarkdown(article.content || "");
---

<PostLayout strapiCollection={article}>
  {html && <div class="w-full" data-render="post" set:html={html} />}
</PostLayout>
