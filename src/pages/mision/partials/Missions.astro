---
import MissionCard from "@/components/MissionCard.astro";
import type { StrapiMission } from "@/types/StrapiMission";

const { strapiCollection } = Astro.props as {
  strapiCollection: StrapiMission[];
};
---

<div class="w-full relative grid grid-cols-4 gap-x-4 gap-y-6 md:grid-cols-8 lg:grid-cols-12 lg:gap-x-6 mx-auto max-w-6xl mb-64 mt-10">
  {strapiCollection.map((m: StrapiMission) => <MissionCard strapiCollection={m} />)}
</div>
