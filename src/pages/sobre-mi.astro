---
import Root from "@/layouts/Root.astro";
import AboutHeroSection from "@/features/about/sections/AboutHeroSection.astro";
import AboutProfileSection from "@/features/about/sections/AboutProfileSection.astro";
import AboutStackSection from "@/features/about/sections/AboutStackSection.astro";
import AboutNextjsSection from "@/features/about/sections/AboutNextjsSection.astro";
import AboutKnowledgeSection from "@/features/about/sections/AboutKnowledgeSection.astro";
import AboutBrandSection from "@/features/about/sections/AboutBrandSection.astro";

const title = "Sobre mí";
const description = "Diseñador UX/UI y desarrollador Frontend detrás de frankuxui. Diseño y desarrollo experiencias digitales modernas, accesibles y optimizadas para conversión, rendimiento y posicionamiento web.";
---

<Root title={title} description={description}>
  <AboutHeroSection />
  <AboutProfileSection />
  <AboutStackSection />
  <AboutNextjsSection />
  <AboutKnowledgeSection />
  <AboutBrandSection />
</Root>
