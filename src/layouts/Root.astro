---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import { siteConfig } from "@/config";
import Footer from "@/components/Footer.astro";
import CookieConsent from "@/components/CookieConsent.astro";
import PaletteModal from "@/components/PaletteModal.astro";
import SiteFeedbackModal from "@/components/SiteFeedbackModal.astro";
import MobileMenuPanel from "@/components/MobileMenuPanel.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  keywords?: string;
}

const { title = siteConfig.title, description = siteConfig.description, image, keywords = siteConfig.keywords } = Astro.props as Props;
---

<!doctype html>
<html lang="en" data-palette="ocean-sunset" style="color-scheme: light;">
  <head class="motion-safe:scroll-smooth">
    <BaseHead title={title} description={description} image={image} keywords={keywords} />
    <ClientRouter />
  </head>
  <body>
    <canvas id="bg-gradient" class="bg-gradient-canvas fixed inset-0 w-full h-full z-0" aria-hidden="true" transition:persist></canvas>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NC3X64JQ" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <Header />
    <CookieConsent />
    <main class="relative z-20 w-full flex flex-col items-center justify-center">
      <slot />
    </main>
    <Footer />
    <div id="portal" class="z-[999]">
      <PaletteModal />
    </div>
    <SiteFeedbackModal />
    <MobileMenuPanel />

    <script>
      let plasmaAnimId: number | null = null;

      function initBgGradient() {
        if (plasmaAnimId !== null) {
          cancelAnimationFrame(plasmaAnimId);
          plasmaAnimId = null;
        }

        const canvas = document.getElementById("bg-gradient") as HTMLCanvasElement;
        if (!canvas) return;

        const ctx = canvas.getContext("2d");
        if (!ctx) return;

        const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        // Baja resolución interna: el CSS la escala a pantalla completa y el blur la suaviza.
        const COLS = 72;
        const ROWS = 46;
        canvas.width = COLS;
        canvas.height = ROWS;

        const palette = [
          [198, 221, 166], // #c6dda6
          [244, 238, 189], // #f4eebd
          [255, 240, 223], // rgb(255, 240, 223)
          [242, 231, 219], // #f2e7db
          [224, 238, 204] // #e0eecc
        ];

        const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
        const smoothstep = (t: number) => t * t * (3 - 2 * t);

        function sampleColor(v: number) {
          const n = palette.length;
          const scaled = (((v % 1) + 1) % 1) * n;
          const i = Math.floor(scaled);
          const frac = smoothstep(scaled - i);
          const c0 = palette[i % n];
          const c1 = palette[(i + 1) % n];
          return [Math.round(lerp(c0[0], c1[0], frac)), Math.round(lerp(c0[1], c1[1], frac)), Math.round(lerp(c0[2], c1[2], frac))];
        }

        const imageData = ctx.createImageData(COLS, ROWS);
        const cx = COLS / 2;
        const cy = ROWS / 2;

        let time = 0;

        function draw() {
          const data = imageData.data;

          for (let y = 0; y < ROWS; y++) {
            for (let x = 0; x < COLS; x++) {
              const dx = x - cx;
              const dy = y - cy;
              const value =
                (Math.sin(x / 18 + time) +
                  Math.sin(y / 18 + time * 1.3) +
                  Math.sin((x + y) / 22 + time * 0.6) +
                  Math.sin(Math.sqrt(dx * dx + dy * dy) / 14 - time)) /
                4;

              const v = (value + 1) / 2;
              const [r, g, b] = sampleColor(v);

              const idx = (y * COLS + x) * 4;
              data[idx] = r;
              data[idx + 1] = g;
              data[idx + 2] = b;
              data[idx + 3] = 255;
            }
          }

          ctx!.putImageData(imageData, 0, 0);

          if (!prefersReducedMotion) {
            time += 0.012;
            plasmaAnimId = requestAnimationFrame(draw);
          }
        }

        draw();
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initBgGradient);
      } else {
        initBgGradient();
      }

      document.addEventListener("astro:page-load", initBgGradient);
    </script>

    <style is:global>
      .bg-gradient-canvas {
        image-rendering: auto;
        filter: blur(28px) saturate(1.05);
        transform: scale(1.08);
      }
    </style>
  </body>
</html>
