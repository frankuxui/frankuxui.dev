---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import { siteConfig } from "@/config";
import Footer from "@/components/Footer.astro";
import CookieConsent from "@/components/CookieConsent.astro";
import PaletteModal from "@/components/PaletteModal.astro";
import SiteFeedbackModal from "@/components/SiteFeedbackModal.astro";
import MobileMenuPanel from "@/components/MobileMenuPanel.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  keywords?: string;
}

const { title = siteConfig.title, description = siteConfig.description, image, keywords = siteConfig.keywords } = Astro.props as Props;
---

<!doctype html>
<html lang="en" data-palette="ocean-sunset" style="color-scheme: light;">
  <head class="motion-safe:scroll-smooth">
    <BaseHead title={title} description={description} image={image} keywords={keywords} />
    <ClientRouter />
  </head>
  <body>
    <canvas id="bg-gradient" class="fixed inset-0 w-full h-full z-0" aria-hidden="true" transition:persist></canvas>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NC3X64JQ" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <Header />
    <CookieConsent />
    <main class="relative z-20 w-full flex flex-col items-center justify-center">
      <slot />
    </main>
    <Footer />
    <div id="portal" class="z-[999]">
      <PaletteModal />
    </div>
    <SiteFeedbackModal />
    <MobileMenuPanel />

    <script>
      import Granim from "granim";

      function initBgGradient() {
        const canvas = document.getElementById("bg-gradient") as HTMLCanvasElement;
        if (!canvas) return;

        const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        new Granim({
          element: canvas,
          direction: "radial",
          isPausedWhenNotInView: false,
          stateTransitionSpeed: 4000,
          states: {
            "default-state": {
              gradients: [
                ["#d4e8b8", "#f0e0b0", "#edd0c0"],
                ["#deecc8", "#ecdcb8", "#e8d0b8"],
                ["#cce4b0", "#f0e4c8", "#f0d8c8"],
                ["#d8eac0", "#e8d8b0", "#e8ccc0"]
              ],
              transitionSpeed: prefersReducedMotion ? 0 : 8000,
              loop: !prefersReducedMotion
            }
          }
        });
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initBgGradient);
      } else {
        initBgGradient();
      }
    </script>
  </body>
</html>
