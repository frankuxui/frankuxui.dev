---
import { ClientRouter } from "astro:transitions";
import type { TransitionAnimationValue } from "astro";
import "../styles/global.css";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import { siteConfig } from "@/config";
import Footer from "@/components/Footer.astro";
// Banner de cookies desactivado por ahora.
// import CookieConsent from "@/components/CookieConsent.astro";
import PaletteModal from "@/components/PaletteModal.astro";
import SiteFeedbackModal from "@/components/SiteFeedbackModal.astro";
import MobileMenuPanel from "@/components/MobileMenuPanel.astro";
import LogoIntroAnimation from "@/components/LogoIntroAnimation.astro";
import NotesSearchModal from "@/components/NotesSearchModal.astro";
import AboutBrandCtaSection from "@/features/about/sections/AboutBrandCtaSection.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  keywords?: string;
  /** Custom astro:transitions animation pair applied to <main>. Defaults to Astro's crossfade. */
  mainAnimate?: TransitionAnimationValue;
}

const { title = siteConfig.title, description = siteConfig.description, image, keywords = siteConfig.keywords, mainAnimate } = Astro.props as Props;
---

<!doctype html>
<html lang="es" data-palette="ocean-sunset" style="color-scheme: light;">
  <head class="motion-safe:scroll-smooth">
    <BaseHead title={title} description={description} image={image} keywords={keywords} />
    <ClientRouter />
    <script is:inline>
      (function () {
        try {
          var id = localStorage.getItem("frankuxui-palette");
          if (id) document.documentElement.dataset.palette = id;
        } catch (e) {}
      })();
      document.addEventListener("keydown", function (e) {
        if ((e.ctrlKey || e.metaKey) && e.key === "k") {
          e.preventDefault();
          window.dispatchEvent(new CustomEvent("frankuxui:search-toggle"));
        }
      });
    </script>
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[9999] focus:rounded-lg focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-foreground focus:outline-none focus:ring-2 focus:ring-primary"
    >
      Ir al contenido principal
    </a>
    <LogoIntroAnimation />
    <canvas id="bg-gradient" class="bg-gradient-canvas fixed inset-0 w-full h-full z-0" aria-hidden="true" transition:persist></canvas>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NC3X64JQ" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <Header />
    {/* Banner de cookies desactivado por ahora. <CookieConsent /> */}
    <main id="main-content" class="relative z-20 w-full flex flex-col items-center justify-center" transition:animate={mainAnimate}>
      <slot />
    </main>
    <AboutBrandCtaSection />
    <Footer />
    <div id="portal" class="z-[999]">
      <PaletteModal />
    </div>
    <div id="popover-portal" class="fixed z-[999] pointer-events-none" style="inset: 0;" transition:persist>
      <NotesSearchModal />
    </div>
    <SiteFeedbackModal />
    <MobileMenuPanel />

    <script>
      type RootNavigationWindow = Window & {
        __biografiaScrollResetAfterSwap?: () => void;
        __biografiaScrollResetPageLoad?: () => void;
      };

      const rootNavigationWindow = window as RootNavigationWindow;
      let plasmaAnimId: number | null = null;

      function resetBiographyEntryScroll() {
        const pathname = window.location.pathname.replace(/\/+$/, "") || "/";
        if (pathname !== "/biografia") return;

        document.documentElement.scrollTop = 0;
        document.body.scrollTop = 0;
        window.scrollTo({ top: 0, left: 0, behavior: "auto" });
      }

      function hexToRgb(hex: string): [number, number, number] {
        const clean = hex.replace("#", "").trim();
        const value = parseInt(clean.length === 3 ? clean.replace(/./g, (c) => c + c) : clean, 16);
        return [(value >> 16) & 255, (value >> 8) & 255, value & 255];
      }

      function getGradientColorsFromCSS(): [number, number, number][] {
        const styles = getComputedStyle(document.documentElement);
        const colors: [number, number, number][] = [];
        for (let i = 1; i <= 5; i++) {
          const hex = styles.getPropertyValue(`--gradient-${i}`).trim();
          if (hex) colors.push(hexToRgb(hex));
        }
        return colors;
      }

      function initBgGradient() {
        if (plasmaAnimId !== null) {
          cancelAnimationFrame(plasmaAnimId);
          plasmaAnimId = null;
        }

        const canvas = document.getElementById("bg-gradient") as HTMLCanvasElement;
        if (!canvas) return;

        const ctx = canvas.getContext("2d");
        if (!ctx) return;

        const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        const COLS = 72;
        const ROWS = 46;
        canvas.width = COLS;
        canvas.height = ROWS;

        const palette = getGradientColorsFromCSS();

        const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
        const smoothstep = (t: number) => t * t * (3 - 2 * t);

        function sampleColor(v: number) {
          const n = palette.length;
          const scaled = (((v % 1) + 1) % 1) * n;
          const i = Math.floor(scaled);
          const frac = smoothstep(scaled - i);
          const c0 = palette[i % n];
          const c1 = palette[(i + 1) % n];
          return [Math.round(lerp(c0[0], c1[0], frac)), Math.round(lerp(c0[1], c1[1], frac)), Math.round(lerp(c0[2], c1[2], frac))];
        }

        const imageData = ctx.createImageData(COLS, ROWS);
        const cx = COLS / 2;
        const cy = ROWS / 2;

        let time = 0;

        function draw() {
          const data = imageData.data;

          for (let y = 0; y < ROWS; y++) {
            for (let x = 0; x < COLS; x++) {
              const dx = x - cx;
              const dy = y - cy;
              const value = (Math.sin(x / 18 + time) + Math.sin(y / 18 + time * 1.3) + Math.sin((x + y) / 22 + time * 0.6) + Math.sin(Math.sqrt(dx * dx + dy * dy) / 14 - time)) / 4;

              const v = (value + 1) / 2;
              const [r, g, b] = sampleColor(v);

              const idx = (y * COLS + x) * 4;
              data[idx] = r;
              data[idx + 1] = g;
              data[idx + 2] = b;
              data[idx + 3] = 255;
            }
          }

          ctx!.putImageData(imageData, 0, 0);

          if (!prefersReducedMotion) {
            time += 0.012;
            plasmaAnimId = requestAnimationFrame(draw);
          }
        }

        draw();
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initBgGradient);
      } else {
        initBgGradient();
      }

      document.addEventListener("astro:page-load", initBgGradient);
      window.addEventListener("frankuxui:palette-change", initBgGradient);

      if (rootNavigationWindow.__biografiaScrollResetAfterSwap) {
        document.removeEventListener("astro:after-swap", rootNavigationWindow.__biografiaScrollResetAfterSwap);
      }
      if (rootNavigationWindow.__biografiaScrollResetPageLoad) {
        document.removeEventListener("astro:page-load", rootNavigationWindow.__biografiaScrollResetPageLoad);
      }

      rootNavigationWindow.__biografiaScrollResetAfterSwap = resetBiographyEntryScroll;
      rootNavigationWindow.__biografiaScrollResetPageLoad = resetBiographyEntryScroll;
      document.addEventListener("astro:after-swap", rootNavigationWindow.__biografiaScrollResetAfterSwap);
      document.addEventListener("astro:page-load", rootNavigationWindow.__biografiaScrollResetPageLoad);

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", resetBiographyEntryScroll, { once: true });
      } else {
        resetBiographyEntryScroll();
      }
    </script>

    <style is:global>
      .bg-gradient-canvas {
        image-rendering: auto;
        filter: blur(28px) saturate(1.05);
        transform: scale(1.08);
      }
    </style>
  </body>
</html>
