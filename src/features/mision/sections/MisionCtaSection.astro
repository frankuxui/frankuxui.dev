<section class="w-full py-16 lg:py-24" aria-labelledby="mision-cta-title">
  <div class="w-full max-w-12xl mx-auto px-10">
    <div class="relative bg-background/10 mx-auto max-w-10xl backdrop-blur-2xl rounded-4xl p-8 sm:p-12 lg:p-16 xl:p-20 overflow-hidden">
      <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-white/50 to-transparent"></div>
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-linear-to-b from-white/10 via-transparent to-transparent"></div>
      <div class="flex w-full flex-col items-start justify-between gap-10 lg:flex-row lg:items-end">
        <div class="max-w-4xl">
          <p class="text-sm font-medium uppercase tracking-[0.22em] text-foreground-muted">Del propósito a la práctica</p>
          <h2 id="mision-cta-title" class="mt-4 font-semibold tracking-tight text-foreground text-[clamp(1.5rem,4vw,5rem)] leading-[1.2]">
            ¿Tienes un producto, una web o una idea que necesita avanzar?
          </h2>
        </div>
        <a
          href="/contacto"
          class="inline-flex items-center justify-center font-medium px-8 h-12 xl:px-12 xl:h-18 xl:text-lg rounded-full bg-primary text-primary-foreground hover:opacity-90 transition-opacity duration-200 flex-none"
        >
          Cuéntame el proyecto
        </a>
      </div>
    </div>
  </div>
</section>
