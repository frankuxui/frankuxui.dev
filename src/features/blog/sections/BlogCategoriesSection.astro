---
// Server island (usado con `server:defer` desde la página que lo importa).
// Se resuelve de forma independiente al listado de posts para que ambas
// llamadas a la API viajen en paralelo y una categoría lenta no bloquee el
// resto de la página.
import CategoryChips from "@/components/blog/CategoryChips.astro";
import { getBlogCategories } from "@/services/blogApiService";

interface Props {
  activeCategory?: string | null;
}

const { activeCategory = null } = Astro.props as Props;
const categories = await getBlogCategories();
---

<section class="w-full border-b-2 border-border" aria-label="Categorías del blog">
  <div class="w-full max-w-7xl 3xl:max-w-8xl mx-auto px-10 py-8">
    {
      categories.length > 0 ? (
        <CategoryChips categories={categories} activeCategory={activeCategory} />
      ) : (
        <p class="text-sm text-foreground/50">No hay categorías disponibles en este momento.</p>
      )
    }
  </div>
</section>
