---
const knowledgeTopics = [
  "Next.js",
  "Tailwind CSS",
  "React",
  "UX/UI",
  "SEO",
  "n8n",
  "Docker",
  "Markdown",
  "MDX",
  "Automatización de contenidos",
  "Integraciones API",
  "Tanstack",
  "Astro",
  "Svelte",
  "Vite",
  "JavaScript",
  "TypeScript",
  "HTML5",
  "CSS3",
  "PM2",
  "Traefik"
];

// Two nowrap rows that will travel in opposite directions on scroll.
const rowOne = knowledgeTopics.filter((_, index) => index % 2 === 0);
const rowTwo = knowledgeTopics.filter((_, index) => index % 2 === 1);

const title = "Conocimiento práctico para diseñadores y desarrolladores.";
const titleWords = title.split(" ");
---

<section class="about-knowledge-fx scroll-mt-32 py-16 lg:py-24 w-full min-w-0 relative isolate" aria-labelledby="about-knowledge-title">
  <!-- Full-bleed panel that rises from the bottom edge and flips the section to
       its dark treatment. Carries the header-contrast hook. -->
  <div class="fx-surface" data-header-contrast="dark" aria-hidden="true"></div>

  <div class="fx-content w-full max-w-5xl mx-auto">
    <div class="fx-text px-6 sm:px-10">
      <p class="fx-eyebrow text-sm font-medium uppercase tracking-[0.22em] text-foreground-muted">Divulgación técnica</p>
      <h2
        id="about-knowledge-title"
        class="fx-title mt-4 font-bold tracking-tight text-foreground max-w-3xl text-[clamp(2.5rem,4vw,5rem)] leading-[1.15]"
        aria-label={title}
      >
        {titleWords.map((word) => <span class="fx-word" aria-hidden="true">{word}</span>)}
      </h2>
      <p class="fx-body mt-8 max-w-2xl text-foreground-muted leading-relaxed" style={{ "font-size": "var(--font-body)" }}>
        Además de construir productos digitales, documento procesos, soluciones y aprendizajes mediante artículos y tutoriales que otras personas puedan aplicar directamente en sus proyectos.
      </p>
    </div>

    <div class="fx-marquee mt-10" aria-label="Temas de divulgación">
      <ul class="fx-row fx-row-1">
        {rowOne.map((topic) => <li class="fx-chip inline-flex items-center justify-center whitespace-nowrap font-medium px-8 h-12 text-sm rounded-full bg-secondary text-secondary-foreground">{topic}</li>)}
      </ul>
      <ul class="fx-row fx-row-2 mt-3">
        {rowTwo.map((topic) => <li class="fx-chip inline-flex items-center justify-center whitespace-nowrap font-medium px-8 h-12 text-sm rounded-full bg-secondary text-secondary-foreground">{topic}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .about-knowledge-fx {
    /* Dark-chapter palette, resolved in JS so GSAP can tween towards it. */
    --fx-surface-color: #0b0b0b;
    --fx-on-dark: #f5f5f0;
    --fx-on-dark-muted: #a5a49e;
    --fx-chip-surface: rgba(245, 245, 240, 0.09);
    --fx-chip-border: rgba(245, 245, 240, 0.22);
  }

  .fx-surface {
    position: absolute;
    z-index: 0;
    inset: 0;
    background: var(--fx-surface-color);
    clip-path: inset(100% 0 0);
    pointer-events: none;
  }

  .fx-content {
    position: relative;
    z-index: 1;
  }

  .fx-word {
    display: inline-block;
    margin-right: 0.25em;
  }
  .fx-word:last-child {
    margin-right: 0;
  }

  .fx-marquee {
    overflow: hidden;
    padding-inline: 1.5rem;
  }
  @media (min-width: 640px) {
    .fx-marquee {
      padding-inline: 2.5rem;
    }
  }

  .fx-row {
    display: flex;
    flex-wrap: nowrap;
    width: max-content;
    gap: 0.75rem;
  }

  /* Transparent border keeps chip metrics steady while GSAP tweens the colour. */
  .fx-chip {
    border: 1px solid transparent;
  }

  .fx-eyebrow,
  .fx-body,
  .fx-word,
  .fx-row {
    will-change: transform, opacity;
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  type FxWindow = Window & {
    __aboutKnowledgeFxCleanup?: () => void;
    __aboutKnowledgeFxLoad?: () => void;
    __aboutKnowledgeFxSwap?: () => void;
  };

  const fxWindow = window as FxWindow;

  function initAboutKnowledgeFx(): () => void {
    const section = document.querySelector(".about-knowledge-fx") as HTMLElement | null;
    if (!section) return () => undefined;

    const surface = section.querySelector(".fx-surface") as HTMLElement | null;
    const eyebrow = section.querySelector(".fx-eyebrow") as HTMLElement | null;
    const words = section.querySelectorAll(".fx-word");
    const body = section.querySelector(".fx-body") as HTMLElement | null;
    const marquee = section.querySelector(".fx-marquee") as HTMLElement | null;
    const rowOne = section.querySelector(".fx-row-1") as HTMLElement | null;
    const rowTwo = section.querySelector(".fx-row-2") as HTMLElement | null;
    const chips = section.querySelectorAll(".fx-chip");
    if (!surface || !eyebrow || !body || !marquee || !rowOne || !rowTwo || words.length === 0) return () => undefined;

    const styles = getComputedStyle(section);
    const onDark = styles.getPropertyValue("--fx-on-dark").trim() || "#f5f5f0";
    const onDarkMuted = styles.getPropertyValue("--fx-on-dark-muted").trim() || "#a5a49e";
    const chipSurface = styles.getPropertyValue("--fx-chip-surface").trim() || "rgba(245,245,240,0.09)";
    const chipBorder = styles.getPropertyValue("--fx-chip-border").trim() || "rgba(245,245,240,0.22)";

    const mm = gsap.matchMedia();

    mm.add(
      {
        isDesktop: "(min-width: 768px)",
        isMobile: "(max-width: 767px)",
        reduced: "(prefers-reduced-motion: reduce)"
      },
      (context) => {
        const { isDesktop, reduced } = context.conditions as { isDesktop: boolean; isMobile: boolean; reduced: boolean };

        if (reduced) {
          gsap.set(surface, { clipPath: "inset(0% 0 0)" });
          gsap.set(eyebrow, { opacity: 1, y: 0, color: onDarkMuted });
          gsap.set(words, { opacity: 1, y: 0, color: onDark });
          gsap.set(body, { opacity: 1, y: 0, color: onDarkMuted });
          gsap.set(chips, { opacity: 1, y: 0, scale: 1, backgroundColor: chipSurface, borderColor: chipBorder, color: onDark });
          return;
        }

        const rise = isDesktop ? 34 : 20;

        // Entrance: panel first (so colour changes land on dark), then text.
        const entrance = gsap.timeline({
          scrollTrigger: {
            trigger: section,
            start: isDesktop ? "top 82%" : "top 90%",
            end: isDesktop ? "top 24%" : "top 32%",
            scrub: 0.8,
            invalidateOnRefresh: true
          }
        });

        entrance
          .fromTo(surface, { clipPath: "inset(100% 0 0)" }, { clipPath: "inset(0% 0 0)", duration: 0.55, ease: "power2.inOut" }, 0)
          .to(eyebrow, { color: onDarkMuted, duration: 0.35, ease: "none" }, 0.2)
          .to(words, { color: onDark, duration: 0.35, ease: "none" }, 0.2)
          .to(body, { color: onDarkMuted, duration: 0.35, ease: "none" }, 0.2)
          .fromTo(eyebrow, { opacity: 0, x: -24 }, { opacity: 1, x: 0, duration: 0.3, ease: "power2.out" }, 0.15)
          .fromTo(
            words,
            { opacity: 0, y: rise, filter: "blur(6px)" },
            { opacity: 1, y: 0, filter: "blur(0px)", duration: 0.45, ease: "power3.out", stagger: 0.045 },
            0.25
          )
          .fromTo(
            body,
            { opacity: 0, y: rise * 0.6, clipPath: "inset(0 0 100% 0)" },
            { opacity: 1, y: 0, clipPath: "inset(0 0 0% 0)", duration: 0.45, ease: "power2.out" },
            ">-0.2"
          )
          .fromTo(
            chips,
            { opacity: 0, y: rise * 0.5, scale: 0.9 },
            {
              opacity: 1,
              y: 0,
              scale: 1,
              backgroundColor: chipSurface,
              borderColor: chipBorder,
              color: onDark,
              duration: 0.4,
              ease: "back.out(1.5)",
              stagger: { each: 0.025, from: "start" }
            },
            ">-0.15"
          );

        // Opposite-direction horizontal scroll for the two rows.
        const overflowOne = () => Math.max(0, rowOne.scrollWidth - marquee.clientWidth);
        const overflowTwo = () => Math.max(0, rowTwo.scrollWidth - marquee.clientWidth);

        gsap.fromTo(
          rowOne,
          { x: () => -overflowOne() * 0.9 },
          {
            x: () => -overflowOne() * 0.05,
            ease: "none",
            scrollTrigger: { trigger: section, start: "top bottom", end: "bottom top", scrub: 0.6, invalidateOnRefresh: true }
          }
        );
        gsap.fromTo(
          rowTwo,
          { x: () => -overflowTwo() * 0.05 },
          {
            x: () => -overflowTwo() * 0.9,
            ease: "none",
            scrollTrigger: { trigger: section, start: "top bottom", end: "bottom top", scrub: 0.6, invalidateOnRefresh: true }
          }
        );
      }
    );

    return () => mm.revert();
  }

  if (fxWindow.__aboutKnowledgeFxLoad) document.removeEventListener("astro:page-load", fxWindow.__aboutKnowledgeFxLoad);
  if (fxWindow.__aboutKnowledgeFxSwap) document.removeEventListener("astro:before-swap", fxWindow.__aboutKnowledgeFxSwap);

  fxWindow.__aboutKnowledgeFxLoad = () => {
    fxWindow.__aboutKnowledgeFxCleanup?.();
    fxWindow.__aboutKnowledgeFxCleanup = initAboutKnowledgeFx();
  };
  fxWindow.__aboutKnowledgeFxSwap = () => {
    fxWindow.__aboutKnowledgeFxCleanup?.();
    fxWindow.__aboutKnowledgeFxCleanup = undefined;
  };

  document.addEventListener("astro:page-load", fxWindow.__aboutKnowledgeFxLoad);
  document.addEventListener("astro:before-swap", fxWindow.__aboutKnowledgeFxSwap);
</script>
