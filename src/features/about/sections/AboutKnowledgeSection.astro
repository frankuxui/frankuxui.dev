---
const knowledgeTopics = [
  "Next.js",
  "Tailwind CSS",
  "React",
  "UX/UI",
  "SEO",
  "n8n",
  "Docker",
  "Markdown",
  "MDX",
  "Automatización de contenidos",
  "Integraciones API",
  "Tanstack",
  "Astro",
  "Svelte",
  "Vite",
  "JavaScript",
  "TypeScript",
  "HTML5",
  "CSS3",
  "PM2",
  "Traefik"
];
---

<section class="scroll-mt-32 py-16 lg:py-24 w-full min-w-0" aria-labelledby="about-knowledge-title">
  <div class="w-full max-w-12xl mx-auto px-10">
    <div class="max-w-4xl">
      <p class="text-sm font-medium uppercase tracking-[0.22em] text-foreground-muted">Divulgación técnica</p>
      <h2 id="about-knowledge-title" class="mt-4 font-bold tracking-tight text-foreground max-w-3xl text-[clamp(2.5rem,4vw,5rem)] leading-[1.2]">
        Conocimiento práctico para diseñadores y desarrolladores.
      </h2>
      <p class="mt-8 max-w-3xl text-foreground-muted leading-relaxed" style={{ "font-size": "var(--font-body)" }}>
        Además de construir productos digitales, documento procesos, soluciones y aprendizajes mediante artículos y tutoriales que otras personas puedan aplicar directamente en sus proyectos.
      </p>
      <ul class="mt-10 flex flex-wrap gap-3" aria-label="Temas de divulgación">
        {knowledgeTopics.map((topic) => <li class="inline-flex items-center justify-center font-medium px-8 h-12 text-sm rounded-full bg-secondary text-secondary-foreground">{topic}</li>)}
      </ul>
    </div>
  </div>
</section>
