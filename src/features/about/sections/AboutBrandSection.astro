---
const brandMeanings = [
  {
    key: "Frank",
    title: "La persona detrás de la marca",
    description: "Mi nombre convierte cada proyecto en un compromiso personal con la calidad, la claridad y el detalle."
  },
  {
    key: "UX",
    title: "Experiencia de usuario",
    description: "Representa entender a las personas, ordenar la complejidad y diseñar recorridos que se sientan naturales."
  },
  {
    key: "UI",
    title: "Interfaz de usuario",
    description: "Expresa la parte visual y tangible: sistemas coherentes, interacción precisa y una identidad reconocible."
  }
];

const socialProfiles = [
  { name: "GitHub", href: "https://github.com/frankuxui" },
  { name: "LinkedIn", href: "https://www.linkedin.com/in/frankuxui/" },
  { name: "Figma", href: "https://www.figma.com/@frankuxui" },
  { name: "CodePen", href: "https://codepen.io/frankuxui" },
  { name: "Instagram", href: "https://www.instagram.com/frankuxui/" }
];
---

<section class="w-full py-16 lg:py-24" aria-labelledby="about-brand-title">
  <div class="w-full max-w-5xl mx-auto px-10">
    <div class="text-center max-w-3xl mx-auto">
      <p class="text-sm font-medium uppercase tracking-[0.22em] text-foreground-muted">Marca personal</p>
      <h2 id="about-brand-title" class="mt-6 font-semibold tracking-tight leading-tight text-foreground text-[clamp(2rem,5vw,6rem)]">
        El significado de <br />
        <span class="text-primary">frankuxui</span>
      </h2>
      <p class="mt-7 max-w-2xl mx-auto text-foreground-muted leading-relaxed" style={{ "font-size": "var(--font-h5)" }}>
        El símbolo reúne mi identidad y las dos disciplinas que orientan mi forma de convertir ideas en productos digitales.
      </p>
    </div>

    <div class="mt-12 flex flex-col gap-6">
      {
        brandMeanings.map((item) => (
          <article class="flex flex-col gap-6 bg-background/30 backdrop-blur-2xl rounded-4xl p-8 sm:p-16 text-center relative overflow-hidden">
            <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-white/50 to-transparent" />
            <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-linear-to-b from-white/10 via-transparent to-transparent" />
            <span class="text-base font-semibold uppercase tracking-[0.22em] text-foreground-muted">{item.key}</span>
            <h3 class="font-semibold tracking-tight text-foreground" style={{ "font-size": "var(--font-h3)" }}>
              {item.title}
            </h3>
            <p class="text-foreground-muted leading-relaxed w-full max-w-2xl mx-auto" style={{ "font-size": "var(--font-h5)" }}>
              {item.description}
            </p>
          </article>
        ))
      }
    </div>

    <div class="mt-6 bg-background/60 mx-auto backdrop-blur-2xl rounded-4xl p-8 sm:p-12 lg:p-16">
      <div class="w-full flex flex-col justify-between gap-6 md:flex-row md:items-center">
        <ul class="flex flex-wrap gap-x-6 gap-y-3" aria-label="Perfiles sociales">
          {
            socialProfiles.map((profile) => (
              <li>
                <a
                  href={profile.href}
                  target="_blank"
                  rel="me noopener noreferrer"
                  class="text-sm text-foreground-muted underline decoration-foreground/20 underline-offset-8 hover:text-foreground transition-colors duration-200"
                >
                  {profile.name}
                </a>
              </li>
            ))
          }
        </ul>
        <a
          href="/contacto"
          class="inline-flex items-center justify-center font-medium px-8 h-12 rounded-full bg-primary text-primary-foreground hover:opacity-90 transition-opacity duration-200 flex-none"
        >
          Contactar
        </a>
      </div>
    </div>
  </div>
</section>
