---
const brandMeanings = [
  {
    key: "Frank",
    title: "La persona detrás de la marca",
    description:
      "Mi nombre convierte cada proyecto en un compromiso personal con la calidad, la claridad y el detalle. Frank representa la parte humana de la marca, la responsabilidad detrás de cada decisión y la implicación directa en cada producto que diseño y desarrollo."
  },
  {
    key: "UX",
    title: "Experiencia de usuario",
    description:
      "Representa entender a las personas, ordenar la complejidad y diseñar recorridos que se sientan naturales. UX es la parte que convierte necesidades, comportamientos y problemas reales en experiencias claras, intuitivas y pensadas para facilitar cada interacción."
  },
  {
    key: "UI",
    title: "Interfaz de usuario",
    description:
      "Expresa la parte visual y tangible del producto: sistemas coherentes, interacción precisa y una identidad reconocible. UI transforma la estrategia y la experiencia en interfaces cuidadas, consistentes y capaces de comunicar con claridad en cada detalle."
  }
];

const titleLead = "Decodificando mi marca personal";
const titleLeadWords = titleLead.split(" ");
---

<section class="about-brand-fx relative w-full" aria-labelledby="about-brand-title">
  <div class="fx-narrative">
    <div class="fx-primary-wash" data-header-contrast="dark" aria-hidden="true"></div>
    <div class="fx-stage mx-auto w-full max-w-12xl px-10">
      <div class="fx-heading text-left">
        <p class="fx-eyebrow text-sm font-medium uppercase tracking-[0.22em] text-foreground-muted">Marca personal</p>
        <h2 id="about-brand-title" class="fx-title mt-6 font-semibold leading-[0.94] tracking-[-0.055em] text-foreground" aria-label={titleLead}>
          <span class="fx-word" aria-hidden="true">{titleLeadWords[0]}</span>
          <br />
          {
            titleLeadWords.slice(1).map((word) => (
              <span class="fx-word" aria-hidden="true">
                {word}
              </span>
            ))
          }
        </h2>
        <p class="fx-lead mt-7 max-w-2xl text-foreground-muted leading-relaxed" style={{ "font-size": "var(--font-h5)" }}>
          El símbolo reúne mi identidad y las dos disciplinas que orientan mi forma de convertir ideas en productos digitales.
        </p>
      </div>

      <div class="fx-logo-scene" role="img" aria-label="Símbolo de Frankuxui">
        <svg class="fx-logo-svg" viewBox="0 0 161 215" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <g class="fx-logo-pieces">
            <path class="fx-logo-piece" data-piece="1" d="M53.66 0H0V53.66H53.66V0Z" fill="currentColor"></path>
            <path class="fx-logo-piece" data-piece="2" d="M53.66 53.6599H0V107.32H53.66V53.6599Z" fill="currentColor"></path>
            <path class="fx-logo-piece" data-piece="3" d="M107.32 107.32H53.6599V160.98H107.32V107.32Z" fill="currentColor"></path>
            <path class="fx-logo-piece" data-piece="4" d="M53.66 160.98H0V214.64H53.66V160.98Z" fill="currentColor"></path>
            <path class="fx-logo-piece" data-piece="5" d="M107.32 0H53.6599V53.66H107.32V0Z" fill="currentColor"></path>
            <path class="fx-logo-piece" data-piece="6" d="M160.98 0H107.32V53.66H160.98V0Z" fill="currentColor"></path>
            <path
              class="fx-logo-piece"
              data-piece="7"
              d="M147.56 214.63C154.966 214.63 160.97 208.626 160.97 201.22C160.97 193.814 154.966 187.81 147.56 187.81C140.154 187.81 134.15 193.814 134.15 201.22C134.15 208.626 140.154 214.63 147.56 214.63Z"
              fill="currentColor"></path>
          </g>
        </svg>
      </div>

      <div class="fx-cards">
        {
          brandMeanings.map((item) => (
            <article class="fx-card flex flex-col">
              <span class="fx-card-key text-base font-semibold uppercase tracking-[0.22em] text-foreground-muted" aria-label={item.key}>
                {Array.from(item.key).map((character) => (
                  <span class="fx-card-char" aria-hidden="true">
                    {character}
                  </span>
                ))}
              </span>
              <h3 class="fx-card-title font-semibold tracking-tight text-foreground" style={{ "font-size": "var(--font-h3)" }}>
                {item.title}
              </h3>
              <p class="fx-card-body w-full text-foreground-muted leading-relaxed" style={{ "font-size": "var(--font-h5)" }}>
                {item.description}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .about-brand-fx {
    isolation: isolate;
    overflow: clip;
    padding-block: 0;
    background: var(--gradient-1);
  }

  .fx-narrative,
  .fx-stage {
    position: relative;
  }

  .fx-primary-wash {
    position: absolute;
    z-index: 1;
    inset: 0;
    pointer-events: none;
    background: var(--primary);
    opacity: 0;
  }

  .fx-stage {
    z-index: 2;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    padding-block: clamp(5rem, 12dvh, 8rem) clamp(2rem, 6dvh, 4rem);
  }

  .fx-heading {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 46rem;
    margin: 0;
  }

  .fx-title {
    font-size: clamp(3.05rem, 12vw, 6rem);
    text-wrap: balance;
  }

  .fx-lead {
    max-width: 38rem;
    text-wrap: pretty;
  }

  .fx-logo-scene {
    position: absolute;
    z-index: 3;
    top: 50%;
    left: 50%;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    transform: translate(-50%, -50%);
  }

  .fx-logo-svg {
    width: clamp(7rem, min(34vw, 16dvh), 10rem);
    height: auto;
    overflow: visible;
    color: var(--primary);
    transform-origin: 50% 50%;
    contain: layout style;
  }

  .fx-logo-piece {
    transform-box: fill-box;
    transform-origin: center;
    will-change: transform, opacity;
  }

  .fx-cards {
    position: absolute;
    z-index: 4;
    inset: 0;
    margin: 0;
  }

  .fx-card {
    position: absolute;
    inset: 0;
    min-height: 0;
    justify-content: center;
    gap: clamp(1rem, 2.4dvh, 1.6rem);
    padding: 0;
    text-align: left;
  }

  .fx-card-key {
    display: flex;
    min-height: 1.25em;
    gap: 0.045em;
    color: var(--primary);
    font-size: clamp(1rem, 1.4vw, 1.25rem);
  }

  .fx-card:first-child .fx-card-key,
  .fx-card:first-child .fx-card-title,
  .fx-card:first-child .fx-card-body {
    color: var(--primary-foreground);
  }

  .fx-card-title {
    max-width: 12ch;
    font-size: clamp(2.65rem, 10vw, 5.5rem) !important;
    line-height: 0.98;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .fx-card-body {
    max-width: 42rem;
    font-size: clamp(1rem, 2vw, 1.25rem) !important;
    line-height: 1.62;
    text-wrap: pretty;
  }

  @media (max-width: 767px) {
    .fx-stage {
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: clamp(1.5rem, 4dvh, 2.5rem);
    }

    .fx-heading {
      order: 2;
      max-width: 100%;
    }

    .fx-logo-scene {
      order: 1;
      position: relative;
      top: auto;
      left: auto;
      width: 100%;
      height: auto;
      justify-content: flex-start;
      transform: none;
    }

    .fx-logo-svg {
      width: clamp(8rem, 38vw, 12rem);
    }

    .fx-cards {
      inset: 0 2.5rem;
    }
  }

  @media (min-width: 768px) and (prefers-reduced-motion: no-preference) {
    .fx-narrative,
    .fx-stage {
      min-height: 100vh;
      min-height: 100dvh;
    }

    .fx-logo-svg {
      width: clamp(12rem, 18vw, 18rem);
    }

    .fx-stage {
      display: grid;
      grid-template-columns: minmax(0, 0.96fr) minmax(0, 1.04fr);
      align-items: center;
      gap: clamp(2rem, 6vw, 8rem);
      padding-block: 0;
    }

    .fx-heading {
      width: auto;
      max-width: 46rem;
    }

    .fx-title {
      font-size: clamp(3.5rem, 5.3vw, 7rem);
    }

    .fx-cards {
      position: relative;
      top: auto;
      right: auto;
      width: auto;
      height: min(68dvh, 48rem);
      margin: 0;
      translate: none;
    }

    .fx-card {
      position: absolute;
      inset: 0;
      min-height: 0;
      padding: 0;
    }

    .fx-card-title {
      font-size: clamp(3rem, 4.45vw, 5.9rem) !important;
    }

    .fx-card-body {
      font-size: clamp(1rem, 1.25vw, 1.3rem) !important;
    }
  }

  @media (min-width: 768px) and (max-width: 1099px) and (prefers-reduced-motion: no-preference) {
    .fx-stage {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: clamp(2rem, 4vw, 3.5rem);
    }

    .fx-title {
      font-size: clamp(3.35rem, 6vw, 5rem);
    }

    .fx-card-title {
      font-size: clamp(2.9rem, 5vw, 4.4rem) !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fx-primary-wash {
      display: none;
    }

    .fx-stage {
      min-height: auto;
      display: block;
      padding-bottom: clamp(4rem, 8dvh, 7rem);
    }

    .fx-logo-scene {
      position: relative;
      top: auto;
      left: auto;
      width: auto;
      height: auto;
      min-height: 10rem;
      margin-block: clamp(3rem, 8dvh, 6rem);
      transform: none;
    }

    .fx-logo-svg,
    .fx-logo-piece {
      opacity: 1;
      transform: none;
      will-change: auto;
    }

    .fx-cards,
    .fx-card {
      position: static;
    }

    .fx-cards {
      display: grid;
    }

    .fx-card {
      min-height: auto;
      padding-block: clamp(2.5rem, 7dvh, 5rem);
    }

    .fx-card:first-child .fx-card-key {
      color: var(--primary);
    }

    .fx-card:first-child .fx-card-title {
      color: var(--foreground);
    }

    .fx-card:first-child .fx-card-body {
      color: var(--foreground-muted);
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  type FxWindow = Window & {
    __aboutBrandFxCleanup?: () => void;
    __aboutBrandFxLoad?: () => void;
    __aboutBrandFxSwap?: () => void;
  };

  const fxWindow = window as FxWindow;

  function initAboutBrandFx(): () => void {
    const section = document.querySelector(".about-brand-fx") as HTMLElement | null;
    if (!section) return () => undefined;

    const narrative = section.querySelector(".fx-narrative") as HTMLElement | null;
    const stage = section.querySelector(".fx-stage") as HTMLElement | null;
    const heading = section.querySelector(".fx-heading") as HTMLElement | null;
    const eyebrow = section.querySelector(".fx-eyebrow") as HTMLElement | null;
    const title = section.querySelector(".fx-title") as HTMLElement | null;
    const words = Array.from(section.querySelectorAll(".fx-word")) as HTMLElement[];
    const lead = section.querySelector(".fx-lead") as HTMLElement | null;
    const primaryWash = section.querySelector(".fx-primary-wash") as HTMLElement | null;
    const logoScene = section.querySelector(".fx-logo-scene") as HTMLElement | null;
    const logoSvg = section.querySelector(".fx-logo-svg") as SVGSVGElement | null;
    const logoPieces = Array.from(section.querySelectorAll(".fx-logo-piece")) as SVGPathElement[];
    const cards = Array.from(section.querySelectorAll(".fx-card")) as HTMLElement[];
    const previousIntroLogo = document.querySelector("#logo-intro-btn") as HTMLElement | null;
    if (!narrative || !stage || !heading || !eyebrow || !title || !lead || !primaryWash || !logoScene || !logoSvg || cards.length !== 3 || logoPieces.length !== 7) {
      return () => undefined;
    }

    const mm = gsap.matchMedia();

    mm.add(
      {
        isDesktop: "(min-width: 768px)",
        isMobile: "(max-width: 767px)",
        reduced: "(prefers-reduced-motion: reduce)"
      },
      (context) => {
        const { isDesktop, reduced } = context.conditions as { isDesktop: boolean; isMobile: boolean; reduced: boolean };
        const titleParts = words;
        const sectionStyles = getComputedStyle(section);
        const introBackground = sectionStyles.getPropertyValue("--gradient-1").trim();
        const foreground = sectionStyles.getPropertyValue("--foreground").trim();
        const foregroundMuted = sectionStyles.getPropertyValue("--foreground-muted").trim();
        const primaryForeground = sectionStyles.getPropertyValue("--primary-foreground").trim();
        const backgroundColors = ["--primary", "--gradient-2", "--gradient-3"].map((token) => sectionStyles.getPropertyValue(token).trim());
        const headingTone = { value: 0 };
        const titleTone = gsap.utils.interpolate(foreground, primaryForeground);
        const copyTone = gsap.utils.interpolate(foregroundMuted, primaryForeground);
        const renderHeadingTone = () => {
          title.style.color = titleTone(headingTone.value);
          eyebrow.style.color = copyTone(headingTone.value);
          lead.style.color = copyTone(headingTone.value);
        };
        const cardParts = cards.map((card) => ({
          card,
          chars: Array.from(card.querySelectorAll(".fx-card-char")) as HTMLElement[],
          title: card.querySelector(".fx-card-title") as HTMLElement,
          body: card.querySelector(".fx-card-body") as HTMLElement
        }));

        if (reduced) {
          gsap.set(section, { backgroundColor: introBackground });
          gsap.set([heading, eyebrow, lead], { clearProps: "all", opacity: 1, x: 0, y: 0 });
          gsap.set(titleParts, { clearProps: "all", opacity: 1, y: 0 });
          gsap.set([logoScene, logoSvg, ...logoPieces], { clearProps: "all", opacity: 1, x: 0, y: 0, scale: 1, rotation: 0 });
          gsap.set(primaryWash, { clearProps: "all", opacity: 0 });
          gsap.set(cards, { clearProps: "all", opacity: 1, x: 0, y: 0, scale: 1 });
          gsap.set(
            cardParts.flatMap(({ chars, title, body }) => [...chars, title, body]),
            { clearProps: "all", opacity: 1, y: 0 }
          );
          return;
        }

        const rise = isDesktop ? 40 : 24;
        const pieceVectors = [
          { x: -0.16, y: -0.16, rotation: -4 },
          { x: -0.18, y: 0, rotation: 3 },
          { x: 0.06, y: 0.08, rotation: -3 },
          { x: -0.15, y: 0.18, rotation: 4 },
          { x: 0, y: -0.18, rotation: -2 },
          { x: 0.18, y: -0.14, rotation: 3 },
          { x: 0.22, y: 0.24, rotation: 0 }
        ];
        const assemblyStates = [
          { x: -0.075, y: -0.055, scale: 0.91, rotation: -3.5, duration: 0.62 },
          { x: -0.09, y: 0.01, scale: 0.94, rotation: 2.5, duration: 0.57 },
          { x: 0.045, y: 0.065, scale: 0.89, rotation: -2.5, duration: 0.66 },
          { x: -0.055, y: 0.09, scale: 0.93, rotation: 3, duration: 0.6 },
          { x: 0.015, y: -0.085, scale: 0.92, rotation: -2, duration: 0.68 },
          { x: 0.085, y: -0.045, scale: 0.9, rotation: 2.5, duration: 0.64 },
          { x: 0.08, y: 0.105, scale: 0.86, rotation: 0, duration: 0.72 }
        ];
        const assemblyOrder = [4, 0, 1, 2, 5, 3, 6];
        const assemblyStarts = [0, 0.055, 0.13, 0.2, 0.27, 0.34, 0.43];
        const departureStarts = [0, 0.035, 0.085, 0.13, 0.06, 0.11, 0.17];
        const getIntroLayout = () => {
          if (!isDesktop) return { headingX: 0, logoX: 0 };

          const stageStyles = getComputedStyle(stage);
          const stageRect = stage.getBoundingClientRect();
          const paddingLeft = Number.parseFloat(stageStyles.paddingLeft) || 0;
          const columnGap = Number.parseFloat(stageStyles.columnGap) || 0;
          const headingWidth = heading.offsetWidth;
          const logoWidth = logoSvg.getBoundingClientRect().width;
          const groupWidth = headingWidth + columnGap + logoWidth;
          const naturalHeadingLeft = stageRect.left + paddingLeft;
          const centeredHeadingLeft = (window.innerWidth - groupWidth) / 2;
          const centeredLogoCenter = centeredHeadingLeft + headingWidth + columnGap + logoWidth / 2;

          return {
            headingX: centeredHeadingLeft - naturalHeadingLeft,
            logoX: centeredLogoCenter - window.innerWidth / 2
          };
        };
        const getPieceExpansion = (piece: SVGPathElement, index: number) => {
          const svgRect = logoSvg.getBoundingClientRect();
          const logoOffsetX = Number(gsap.getProperty(logoSvg, "x")) || 0;
          const box = piece.getBBox();
          const pieceWidth = Math.max((box.width / 161) * svgRect.width, 1);
          const pieceHeight = Math.max((box.height / 215) * svgRect.height, 1);
          const centerX = svgRect.left - logoOffsetX + ((box.x + box.width / 2) / 161) * svgRect.width;
          const centerY = svgRect.top + ((box.y + box.height / 2) / 215) * svgRect.height;
          const vector = pieceVectors[index];
          const x = vector.x * window.innerWidth * 0.8;
          const y = vector.y * window.innerHeight * 0.8;
          const targetCenterX = centerX + x;
          const targetCenterY = centerY + y;
          const requiredWidth = Math.max(targetCenterX, window.innerWidth - targetCenterX) * 2;
          const requiredHeight = Math.max(targetCenterY, window.innerHeight - targetCenterY) * 2;

          return {
            x,
            y,
            scale: Math.max(requiredWidth / pieceWidth, requiredHeight / pieceHeight) * 1.1
          };
        };
        const storyTl = gsap.timeline({
          scrollTrigger: {
            trigger: narrative,
            start: "top top",
            end: () => `+=${Math.round(window.innerHeight * (isDesktop ? 7.6 : 8.1))}`,
            pin: true,
            pinSpacing: "margin",
            scrub: isDesktop ? 0.9 : 0.65,
            anticipatePin: 1,
            refreshPriority: -1,
            invalidateOnRefresh: true
          }
        });

        gsap.set(section, { backgroundColor: introBackground });
        gsap.set(primaryWash, { opacity: 0 });
        gsap.set(eyebrow, { opacity: 0, y: rise * 0.35 });
        gsap.set(titleParts, { opacity: 0, y: rise });
        gsap.set(lead, { opacity: 0, y: rise * 0.45 });
        gsap.set(logoScene, { opacity: 0 });
        logoPieces.forEach((piece, index) => {
          const state = assemblyStates[index];
          const assemblyDistance = Math.min(window.innerWidth, window.innerHeight);
          gsap.set(piece, {
            opacity: 0,
            x: state.x * assemblyDistance,
            y: state.y * assemblyDistance,
            scale: state.scale,
            rotation: state.rotation,
            transformOrigin: "50% 50%",
            force3D: true
          });
        });
        gsap.set(cards, { opacity: 0, y: rise * 0.7 });
        cardParts.forEach(({ chars, title, body }) => {
          gsap.set(chars, { opacity: 0, y: 10 });
          gsap.set(title, { opacity: 0, y: 16 });
          gsap.set(body, { opacity: 0, y: 10 });
        });

        if (previousIntroLogo) {
          storyTl.to(previousIntroLogo, { opacity: 0, duration: 0.18, ease: "none" }, 0);
        }

        storyTl
          .to(eyebrow, { opacity: 1, y: 0, duration: 0.24, ease: "power2.out" }, 0)
          .to(titleParts, { opacity: 1, y: 0, duration: 0.5, stagger: 0.065, ease: "power3.out" }, 0.08)
          .to({}, { duration: 0.16 })
          .to(lead, { opacity: 1, y: 0, duration: 0.36, ease: "power2.out" })
          .to({}, { duration: 0.36 })
          .to(logoScene, { opacity: 1, duration: 0.08, ease: "none" })
          .addLabel("logoAssembly");

        assemblyOrder.forEach((pieceIndex, sequenceIndex) => {
          const state = assemblyStates[pieceIndex];
          storyTl.to(logoPieces[pieceIndex], { opacity: 1, x: 0, y: 0, scale: 1, rotation: 0, duration: state.duration, ease: "power3.out" }, `logoAssembly+=${assemblyStarts[sequenceIndex]}`);
        });

        storyTl.to({}, { duration: 0.5 }).addLabel("logoExpansion");

        storyTl
          .fromTo(heading, { x: () => getIntroLayout().headingX }, { x: 0, duration: 1.08, ease: "power2.inOut", immediateRender: true }, "logoExpansion")
          .fromTo(logoSvg, { x: () => getIntroLayout().logoX }, { x: 0, duration: 0.96, ease: "power2.inOut", immediateRender: true }, "logoExpansion");

        logoPieces.forEach((piece, index) => {
          storyTl.to(
            piece,
            {
              x: () => getPieceExpansion(piece, index).x,
              y: () => getPieceExpansion(piece, index).y,
              scale: () => getPieceExpansion(piece, index).scale,
              rotation: index === 6 ? 0 : pieceVectors[index].rotation * 0.35,
              duration: index === 6 ? 1.62 : 1.48,
              ease: index === 6 ? "sine.inOut" : "power1.inOut"
            },
            `logoExpansion+=${departureStarts[index]}`
          );
        });

        storyTl
          .to(headingTone, { value: 1, duration: 0.3, ease: "none" }, "logoExpansion+=0.32")
          .to(primaryWash, { opacity: 1, duration: 0.24, ease: "none" }, "logoExpansion+=1.55")
          .set(section, { backgroundColor: backgroundColors[0] })
          .set(logoScene, { opacity: 0 })
          .set(logoPieces, { x: 0, y: 0, scale: 1, rotation: 0 })
          .to({}, { duration: 0.34 });

        if (!isDesktop) {
          storyTl.set(logoScene, { zIndex: 6 }, "logoExpansion");
        }

        cardParts.forEach(({ card, chars, title, body }, index) => {
          if (index > 0) {
            storyTl
              .to(cardParts[index - 1].card, { opacity: 0, y: -24, duration: 0.34, ease: "power2.inOut" })
              .to(section, { backgroundColor: backgroundColors[index], duration: 0.46, ease: "none" }, "<+0.08");

            if (index === 1) {
              storyTl.to(primaryWash, { opacity: 0, duration: 0.46, ease: "none" }, "<").to(headingTone, { value: 0, duration: 0.36, ease: "none" }, "<");
            }
          }

          storyTl
            .to(card, { opacity: 1, y: 0, duration: 0.22, ease: "power2.out" }, index > 0 ? ">-0.08" : ">")
            .to(chars, { opacity: 1, y: 0, duration: 0.16, stagger: 0.045, ease: "power2.out" }, ">-0.04")
            .to(title, { opacity: 1, y: 0, duration: 0.28, ease: "power2.out" }, ">+0.04")
            .to(body, { opacity: 1, y: 0, duration: 0.25, ease: "power2.out" }, ">+0.04")
            .to({}, { duration: index === cardParts.length - 1 ? 0.62 : 0.46 });
        });

        if (previousIntroLogo) {
          storyTl.to(previousIntroLogo, { opacity: 1, duration: 0.18, ease: "none" }, ">-0.18");
        }

        // Render the contrast state after every child tween so the intro
        // animation cannot restore stale inline colors on the heading.
        storyTl.eventCallback("onUpdate", renderHeadingTone);
        renderHeadingTone();

        requestAnimationFrame(() => ScrollTrigger.refresh());

        return () => {
          title.style.removeProperty("color");
          eyebrow.style.removeProperty("color");
          lead.style.removeProperty("color");
        };
      }
    );

    return () => mm.revert();
  }

  if (fxWindow.__aboutBrandFxLoad) document.removeEventListener("astro:page-load", fxWindow.__aboutBrandFxLoad);
  if (fxWindow.__aboutBrandFxSwap) document.removeEventListener("astro:before-swap", fxWindow.__aboutBrandFxSwap);

  fxWindow.__aboutBrandFxLoad = () => {
    fxWindow.__aboutBrandFxCleanup?.();
    fxWindow.__aboutBrandFxCleanup = initAboutBrandFx();
  };
  fxWindow.__aboutBrandFxSwap = () => {
    fxWindow.__aboutBrandFxCleanup?.();
    fxWindow.__aboutBrandFxCleanup = undefined;
  };

  document.addEventListener("astro:page-load", fxWindow.__aboutBrandFxLoad);
  document.addEventListener("astro:before-swap", fxWindow.__aboutBrandFxSwap);
</script>
