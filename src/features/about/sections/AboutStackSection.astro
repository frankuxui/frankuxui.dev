---
const technologyGroups = [
  {
    title: "Frontend",
    items: [
      { name: "HTML5", description: "Marcado semántico y accesible como base de toda interfaz web." },
      { name: "CSS3", description: "Layouts modernos con Grid, Flexbox, custom properties y animaciones." },
      { name: "JavaScript", description: "Lógica interactiva, manipulación del DOM y consumo de APIs." },
      { name: "TypeScript", description: "Tipado estático para código más robusto y mantenible." },
      { name: "React", description: "Componentes reutilizables, estado y renderizado declarativo." },
      { name: "Next.js", description: "Framework fullstack con SSR, SSG y App Router para producción." },
      { name: "Tailwind CSS", description: "Utility-first CSS para diseño rápido y consistente." },
      { name: "Shadcn UI", description: "Componentes accesibles y personalizables sobre Radix." }
    ]
  },
  {
    title: "Contenido",
    items: [
      { name: "Markdown", description: "Formato ligero para escribir contenido estructurado." },
      { name: "MDX", description: "Markdown con componentes React integrados." },
      { name: "Frontmatter", description: "Metadatos YAML para gestionar contenido estático." }
    ]
  },
  {
    title: "Infraestructura",
    items: [
      { name: "Ubuntu Server", description: "Sistema operativo base para servidores de producción." },
      { name: "PM2", description: "Gestor de procesos Node.js con reinicio automático." },
      { name: "Nginx", description: "Servidor web y proxy inverso de alto rendimiento." },
      { name: "Traefik", description: "Proxy inverso con SSL automático y descubrimiento de servicios." },
      { name: "Docker", description: "Contenedores para despliegues reproducibles y aislados." }
    ]
  },
  {
    title: "Automatización",
    items: [
      { name: "n8n", description: "Plataforma visual de automatización de flujos de trabajo." },
      { name: "Integraciones API", description: "Conexión entre servicios mediante REST y webhooks." },
      { name: "Automatización de contenidos", description: "Pipelines de publicación y distribución automática." },
      { name: "Flujos de publicación", description: "CI/CD y despliegues automatizados desde el repositorio." }
    ]
  }
];

const allItems = technologyGroups.flatMap((group) => group.items.map((item) => ({ ...item, group: group.title })));
---

<section class="scroll-mt-32 py-16 lg:py-24 w-full min-w-0" aria-labelledby="about-stack-title">
  <div class="w-full max-w-5xl mx-auto px-10">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6">
      <div>
        <p class="text-sm font-medium uppercase tracking-[0.22em] text-foreground-muted">Stack técnico</p>
        <h2 id="about-stack-title" class="mt-4 font-semibold tracking-tight text-foreground max-w-3xl text-[clamp(3rem,4vw,5rem)] leading-[1.2]">
          Herramientas elegidas para construir, publicar y escalar.
        </h2>
      </div>
      <div class="flex items-center gap-4 flex-none">
        <button
          type="button"
          class="stack-prev inline-flex items-center justify-center size-12 rounded-full bg-secondary text-foreground hover:bg-secondary/80 transition-colors duration-200 cursor-pointer"
          aria-label="Anterior tecnología"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path>
          </svg>
        </button>
        <button
          type="button"
          class="stack-next inline-flex items-center justify-center size-12 rounded-full bg-secondary text-foreground hover:bg-secondary/80 transition-colors duration-200 cursor-pointer"
          aria-label="Siguiente tecnología"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div class="stack-swiper-container mt-10 w-full">
    <div class="stack-swiper">
      <div class="swiper-wrapper">
        {
          allItems.map((item) => (
            <div class="swiper-slide h-auto w-full min-w-sm max-w-md">
              <div class="relative overflow-hidden flex items-start flex-col gap-3 rounded-3xl bg-background/40 backdrop-blur-xl p-6 sm:p-8 h-full">
                <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-white/50 to-transparent" />
                <div class="flex items-center gap-4 w-full">
                  <div class="flex-none size-14 rounded-full bg-foreground text-background flex items-center justify-center text-xl font-bold">{item.name.charAt(0)}</div>
                  <div class="flex flex-col gap-1 min-w-0">
                    <span class="text-xs font-medium uppercase tracking-[0.15em] text-foreground-muted/60">{item.group}</span>
                    <span class="font-semibold text-foreground" style={{ "font-size": "var(--font-body)" }}>
                      {item.name}
                    </span>
                  </div>
                </div>
                <p class="text-foreground-muted text-base leading-relaxed">{item.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style is:global>
  .stack-swiper-container {
    overflow: hidden;
    width: 100%;
  }

  .stack-swiper {
    overflow: hidden;
    width: 100%;
    position: relative;
  }

  .stack-swiper .swiper-wrapper {
    display: flex;
  }
</style>

<script>
  import Swiper from "swiper";
  import { Navigation } from "swiper/modules";
  import "swiper/css";

  let stackSwiperInstance: Swiper | null = null;

  function initStackSwiper() {
    if (stackSwiperInstance) {
      stackSwiperInstance.destroy(true, true);
      stackSwiperInstance = null;
    }

    const el = document.querySelector(".stack-swiper") as HTMLElement;
    if (!el) return;

    stackSwiperInstance = new Swiper(el, {
      modules: [Navigation],
      slidesPerView: 1.12,
      centeredSlides: true,
      spaceBetween: 14,
      grabCursor: true,
      watchOverflow: true,
      speed: 550,
      cssMode: false,
      resistanceRatio: 0.85,
      navigation: {
        prevEl: ".stack-prev",
        nextEl: ".stack-next"
      },
      breakpoints: {
        640: { slidesPerView: 1.6, spaceBetween: 24, centeredSlides: false },
        768: { slidesPerView: 2.2, spaceBetween: 24, centeredSlides: false },
        1024: { slidesPerView: 3, spaceBetween: 24, centeredSlides: false },
        1280: { slidesPerView: 3.5, spaceBetween: 24, centeredSlides: false },
        1536: { slidesPerView: 4, spaceBetween: 24, centeredSlides: false },
        1920: { slidesPerView: 4.5, spaceBetween: 24, centeredSlides: false },
        2560: { slidesPerView: 6, spaceBetween: 24, centeredSlides: false },
        3840: { slidesPerView: 7, spaceBetween: 24, centeredSlides: false }
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initStackSwiper);
  } else {
    initStackSwiper();
  }

  document.addEventListener("astro:page-load", initStackSwiper);
</script>
