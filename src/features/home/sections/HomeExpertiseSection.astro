---
const expertise = [
  {
    number: "01",
    title: "UX/UI y sistemas de diseño",
    description: "Experiencias claras y accesibles construidas desde la investigación, la jerarquía visual y componentes consistentes."
  },
  {
    number: "02",
    title: "Frontend moderno",
    description: "Interfaces con React, Next.js y TypeScript que equilibran calidad técnica, rendimiento y facilidad de mantenimiento."
  },
  {
    number: "03",
    title: "SEO y rendimiento",
    description: "Arquitecturas, contenido y optimizaciones técnicas pensadas para buscadores, Core Web Vitals y conversión."
  },
  {
    number: "04",
    title: "CMS y automatización",
    description: "Sistemas de contenido con Markdown, MDX y flujos automatizados mediante n8n e integraciones API."
  }
];
---

<section id="sobre-mi" class="scroll-mt-32 border-b-2 border-border" aria-labelledby="home-expertise-title">
  <div class="w-full max-w-7xl 3xl:max-w-8xl mx-auto lg:px-10">
    <div class="mx-auto grid lg:grid-cols-2 items-stretch isolate relative">
      <div class="bg-foreground text-background">
        <div class="lg:sticky lg:top-28 lg:self-start lg:py-32">
          <div class="px-10 py-20 lg:p-20">
            <p class="text-sm font-medium uppercase tracking-[0.22em] text-background">Perfil híbrido</p>
            <h2 id="home-expertise-title" class="mt-4 leading-11 text-3xl 2xl:text-4xl 3xl:text-5xl 3xl:leading-14 font-semibold tracking-tight">
              De la estrategia a una experiencia lista para producción.
            </h2>
            <a href="/sobre-mi" class="mt-10 inline-flex items-center gap-2 font-semibold underline decoration-foreground/30 underline-offset-8 transition-colors hover:decoration-foreground">
              Leer más sobre mi trayectoria <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
      <div class="w-full">
        <div class="grid overflow-hidden divide-y-2 divide-border border-r-2">
          {
            expertise.map((item) => (
              <article class="min-h-72 border-b-2 border-border p-8 sm:p-10 hover:bg-foreground/2 transition-colors duration-500 last:border-b-0">
                <span class="text-sm text-foreground/40">{item.number}</span>
                <h3 class="mt-12 text-2xl font-semibold tracking-tight sm:text-3xl">{item.title}</h3>
                <p class="mt-5 max-w-xl leading-relaxed text-foreground/70">{item.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
