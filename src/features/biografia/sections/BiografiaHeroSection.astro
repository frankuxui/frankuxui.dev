---
const horizontalCards = [
  {
    number: "01",
    label: "Enfoque",
    title: "Diseño con propósito",
    body: "Cada interfaz nace de una intención: resolver problemas, simplificar decisiones y transformar ideas en experiencias digitales claras."
  },
  {
    number: "02",
    label: "Ingeniería",
    title: "Código que evoluciona",
    body: "Construyo productos frontend preparados para crecer, combinando arquitectura, rendimiento, accesibilidad y una experiencia de desarrollo sostenible."
  },
  {
    number: "03",
    label: "Interacción",
    title: "Movimiento y detalle",
    body: "La animación no es decoración. Utilizo motion para comunicar jerarquía, crear contexto y convertir cada interacción en una experiencia más natural."
  },
  {
    number: "04",
    label: "Producto",
    title: "Producto y experiencia",
    body: "Diseño y desarrollo forman parte del mismo proceso. Cada decisión visual debe funcionar también desde la lógica, el producto y la tecnología."
  },
  {
    number: "05",
    label: "Aprendizaje",
    title: "Evolución constante",
    body: "Aprender, experimentar y mejorar forman parte de mi manera de trabajar. Cada proyecto es una oportunidad para construir algo mejor que lo anterior."
  }
];

const verticalCards = [
  {
    number: "01",
    image: "/biography-cards/card-01.webp",
    title: "Diseño con intención",
    body: "Cada decisión visual debe responder a un propósito, no solamente a una tendencia."
  },
  {
    number: "02",
    image: "/biography-cards/card-02.webp",
    title: "Experiencia primero",
    body: "Diseñar significa entender cómo piensa, navega y toma decisiones una persona."
  },
  {
    number: "03",
    image: "/biography-cards/card-03.webp",
    title: "Código sostenible",
    body: "Una buena interfaz también necesita una arquitectura preparada para crecer."
  },
  {
    number: "04",
    image: "/biography-cards/card-04.webp",
    title: "Movimiento funcional",
    body: "La animación debe explicar, acompañar y mejorar la interacción."
  },
  {
    number: "05",
    image: "/biography-cards/card-05.webp",
    title: "Evolución constante",
    body: "Cada proyecto es una oportunidad para aprender, experimentar y construir algo mejor."
  }
];

const finalLines = ["Crear.", "Evolucionar.", "Volver a crear."];
---

<script is:inline>
  document.documentElement.classList.add("biografia-js");
  const isMobileBiography = window.matchMedia("(max-width: 767px)").matches;
  if (!isMobileBiography && "scrollRestoration" in history) {
    if (!("__biografiaPreviousScrollRestoration" in window)) {
      window.__biografiaPreviousScrollRestoration = history.scrollRestoration;
    }
    history.scrollRestoration = "manual";
  }
  if (!isMobileBiography) window.scrollTo(0, 0);
</script>

