        <path class="bio-letter" d="M4094 8.75757V569.242H3971.27V8.75757H4094Z"/>
      </svg>
    </div>
  </div>

  <!-- FIXED layer: Photo (in front of logo, ALWAYS fixed, only blurs) -->
  <div class="biografia-photo-layer fixed inset-0 flex items-end justify-center pointer-events-none" style="z-index: 3;">
    <img
      src="/imagen-biography-frankuxui.png"
      alt="Frank Esteban"
      class="biografia-photo block select-none"
      style="height: clamp(72dvh, 96dvh, 1040px); aspect-ratio: 1/1; object-fit: cover; object-position: top center; will-change: filter, opacity;"
    />
  </div>

  <!-- FIXED layer: Aside (left texts). Always visible; each text animates in
       sequentially as you scroll, after the logo animation finishes. -->
  <div class="biografia-aside fixed inset-y-0 left-0 flex items-center pointer-events-none" style="z-index: 4;">
    <div class="biografia-aside-inner flex flex-col gap-6" style="padding-left: clamp(2rem, 7vw, 9rem); padding-right: 2rem; max-width: min(46rem, 52vw);">
      <p class="biografia-eyebrow font-semibold uppercase" style="font-size: clamp(0.9rem, 1.1vw, 1.15rem); letter-spacing: 0.28em; color: var(--primary);">Biografía</p>
      <h1 class="biografia-title font-bold tracking-tight leading-[0.98]" style="font-size: var(--font-h1); color: var(--foreground);">La historia<br />de mi vida</h1>
      <p class="biografia-desc" style="font-size: clamp(1.15rem, 1.6vw, 1.6rem); line-height: 1.5; color: var(--foreground-muted); max-width: 34rem;">Diseñador UX/UI y desarrollador Frontend con más de 7 años creando experiencias digitales.</p>
    </div>
  </div>

  <!-- Scroll region that drives the intro (logo shrink + photo blur) -->
  <div class="biografia-hero-spacer w-full" style="height: 240vh;"></div>

  <!-- Scroll region that drives the aside text reveal (one after another) -->
  <div class="biografia-reveal w-full" style="height: 140vh;"></div>

  <!-- Body: right content, centered in the space beside the fixed aside -->
  <div class="biografia-body relative w-full" style="z-index: 20;">
    <div class="biografia-content w-full">
      <div class="biografia-lorem relative w-full max-w-2xl mx-auto rounded-4xl bg-background/20 backdrop-blur-2xl overflow-hidden transition-colors duration-200 border border-white/80 shadow-[1px_1px_87px_4px_color-mix(in_srgb,var(--color-primary)_10%,transparent)]">
        <div class="flex flex-col gap-14 p-8 sm:p-12">
          {loremBlocks.map((block) => (
            <article class="flex flex-col gap-4">
              <h3 class="font-semibold tracking-tight" style="font-size: var(--font-h3); color: var(--foreground);">{block.title}</h3>
              <p style="font-size: var(--font-h5); line-height: 1.7; color: var(--foreground-muted);">{block.body}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>

</section>

<style>
  /* Logo color follows the palette variable, so it updates live on palette
     change. It only turns white once it has fully entered its box. */
  .bio-letter {
    fill: var(--primary);
    transition: fill 0.4s ease;
  }
  .biografia-logo-svg.is-white .bio-letter {
    fill: #ffffff;
  }

  .biografia-logo-shell {
    background-color: transparent;
    transition: background-color 0.4s ease;
  }
  .biografia-logo-shell.is-boxed {
    background-color: #0a0a0a;
  }

  /* Center the right content in the space to the right of the fixed aside. */
  .biografia-content {
    padding: 12dvh 2.5rem 16dvh;
  }
  @media (min-width: 1024px) {
    .biografia-content {
      padding-left: 40vw;
      padding-right: 4vw;
      padding-top: 30dvh;
      padding-bottom: 40dvh;
    }
  }

  /* On small screens the aside is not a fixed side column: it stacks on top. */
  @media (max-width: 1023px) {
    .biografia-aside {
      position: absolute;
      inset: 0 0 auto 0;
      height: auto;
      align-items: flex-start;
      padding-top: 26dvh;
    }
  }

  @media (max-width: 640px) {
    .biografia-photo {
      height: 80dvh !important;
    }
  }
  @media (min-width: 641px) and (max-width: 1024px) {
    .biografia-photo {
      height: 90dvh !important;
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const FINAL_SCALE = 0.12;

  function initBiografiaScroll() {
    const section = document.querySelector("#biografia-hero");
    if (!section) return;

    const spacer = section.querySelector(".biografia-hero-spacer") as HTMLElement;
    const reveal = section.querySelector(".biografia-reveal") as HTMLElement;
    const logoShell = section.querySelector(".biografia-logo-shell") as HTMLElement;
    const logoSvg = section.querySelector(".biografia-logo-svg") as HTMLElement;
    const letters = section.querySelectorAll(".bio-letter");
    const photoLayer = section.querySelector(".biografia-photo-layer") as HTMLElement;
    const photo = section.querySelector(".biografia-photo") as HTMLElement;
    const logoLayer = section.querySelector(".biografia-logo-layer") as HTMLElement;
    const asideLayer = section.querySelector(".biografia-aside") as HTMLElement;
    const asideInner = section.querySelector(".biografia-aside-inner") as HTMLElement;
    const eyebrow = section.querySelector(".biografia-eyebrow") as HTMLElement;
    const title = section.querySelector(".biografia-title") as HTMLElement;
    const desc = section.querySelector(".biografia-desc") as HTMLElement;
    const content = section.querySelector(".biografia-lorem") as HTMLElement;

    if (!spacer || !reveal || !logoShell || !logoSvg || !photo || letters.length === 0) return;

    // Clean previous triggers tied to this section.
    ScrollTrigger.getAll().forEach((st) => {
      const t = st.vars.trigger;
      if (t === spacer || t === reveal || t === content) st.kill();
    });

    // Split the title into characters (once) so it can reveal left-to-right.
    let titleChars: HTMLElement[] = [];
    if (title) {
      if (!title.dataset.split) {
        const nodes = Array.from(title.childNodes);
        title.innerHTML = "";
        nodes.forEach((node) => {
          if (node.nodeType === Node.TEXT_NODE) {
            for (const ch of node.textContent || "") {
              const span = document.createElement("span");
              span.textContent = ch;
              span.style.display = "inline-block";
              span.style.whiteSpace = "pre";
              title.appendChild(span);
            }
          } else if (node.nodeName === "BR") {
            title.appendChild(document.createElement("br"));
          } else {
            title.appendChild(node);
          }
        });
        title.dataset.split = "true";
      }
      titleChars = Array.from(title.querySelectorAll("span")) as HTMLElement[];
    }

    // --- Phase 0: Intro (letter-by-letter reveal of the big logo) ---
    document.documentElement.style.overflow = "hidden";

    gsap.set(photo, { opacity: 0, y: 40, filter: "blur(0px)" });
    gsap.set(logoShell, { scale: 1, x: 0, y: 0, transformOrigin: "50% 50%" });
    gsap.set(letters, { opacity: 0, y: 30 });

    // Aside texts start hidden; they animate in during the reveal scroll.
    if (eyebrow) gsap.set(eyebrow, { opacity: 0, y: 24 });
    if (titleChars.length) gsap.set(titleChars, { opacity: 0, x: -24 });
    if (desc) gsap.set(desc, { opacity: 0, y: 24 });

    const introTl = gsap.timeline({
      onComplete: () => {
        document.documentElement.style.overflow = "";
        initScrollAnimations();
      }
    });

    introTl.to(letters, {
      opacity: 1,
      y: 0,
      duration: 0.12,
      stagger: 0.07,
      ease: "power1.out",
      delay: 0.3
    });

    introTl.to(photo, { opacity: 1, y: 0, duration: 0.8, ease: "power2.out" }, "-=0.25");

    function computeTarget() {
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      const shellRect = logoShell.getBoundingClientRect();
      const scaledW = shellRect.width * FINAL_SCALE;
      const scaledH = shellRect.height * FINAL_SCALE;

      // Align the logo box left edge with the aside text left edge.
      let targetLeft = Math.min(Math.max(vw * 0.07, 32), 144);
      if (asideInner) {
        const r = asideInner.getBoundingClientRect();
        if (r.left > 0) targetLeft = r.left;
      }
      const targetTop = Math.max(vh * 0.12, 92);

      const targetCenterX = targetLeft + scaledW / 2;
      const targetCenterY = targetTop + scaledH / 2;

      return { x: targetCenterX - vw / 2, y: targetCenterY - vh / 2 };
    }

    function initScrollAnimations() {
      // --- Intro scroll: photo blurs, logo shrinks to the corner. The box +
      // white color appear ONLY at the very end (>=95%), once fully shrunk. ---
      const introScroll = gsap.timeline({
        scrollTrigger: {
          trigger: spacer,
          start: "top top",
          end: "bottom bottom",
          scrub: 1,
          invalidateOnRefresh: true,
          onUpdate: (self) => {
            const boxed = self.progress >= 0.95;
            logoShell.classList.toggle("is-boxed", boxed);
            logoSvg.classList.toggle("is-white", boxed);
          }
        }
      });

      introScroll.to(photo, { filter: "blur(22px)", opacity: 0.5, duration: 0.55, ease: "none" }, 0);
      introScroll.to(
        logoShell,
        {
          scale: FINAL_SCALE,
          x: () => computeTarget().x,
          y: () => computeTarget().y,
          duration: 1,
          ease: "power2.inOut"
        },
        0
      );

      // --- Reveal scroll: aside texts enter one after another as you scroll. ---
      const revealTl = gsap.timeline({
        scrollTrigger: {
          trigger: reveal,
          start: "top bottom",
          end: "bottom bottom",
          scrub: 1,
          invalidateOnRefresh: true
        }
      });

      if (eyebrow) revealTl.to(eyebrow, { opacity: 1, y: 0, ease: "power2.out", duration: 0.6 }, 0.05);
      if (titleChars.length)
        revealTl.to(titleChars, { opacity: 1, x: 0, ease: "power2.out", duration: 0.6, stagger: 0.03 }, 0.3);
      if (desc) revealTl.to(desc, { opacity: 1, y: 0, ease: "power2.out", duration: 0.6 }, 1.1);

      // --- Fade the fixed layers out as the section ends (keeps footer clean). ---
      if (content) {
        gsap.to([photoLayer, logoLayer, asideLayer], {
          autoAlpha: 0,
          ease: "none",
          scrollTrigger: {
            trigger: content,
            start: "bottom 85%",
            end: "bottom 35%",
            scrub: true
          }
        });
      }
    }
  }

  document.addEventListener("astro:page-load", initBiografiaScroll);
</script>
