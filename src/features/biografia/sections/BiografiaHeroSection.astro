  <div class="biografia-photo-layer absolute inset-0 flex items-end justify-center pointer-events-none" style="z-index: 26;">
    <picture class="contents">
      <source srcset="/imagen-biography-frankuxui-mobile.png" media="(max-width: 767px)" />
