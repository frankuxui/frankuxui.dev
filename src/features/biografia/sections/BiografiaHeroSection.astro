    </div>
  </div>
</section>

<section class="biografia-horizontal-section relative" data-header-contrast="dark" aria-labelledby="biografia-horizontal-title">
  <header class="biografia-horizontal-header">
    <div class="biografia-horizontal-heading">
      <p class="biografia-horizontal-eyebrow">Visión y proceso</p>
      <h2 id="biografia-horizontal-title">Diseño y desarrollo<br />pensados para avanzar</h2>
    </div>
    <p class="biografia-horizontal-intro">
      Más de siete años construyendo experiencias digitales donde estrategia, diseño, código y movimiento trabajan juntos para dar forma a productos claros, sólidos y memorables.
    </p>
  </header>
  <div class="biografia-horizontal-viewport">
    <div class="biografia-horizontal-track">
      {
        horizontalCards.map((card, index) => (
          <article class="biografia-card">
            <div class="biografia-card-meta">
              <span class="biografia-card-number">{card.number}</span>
              <span class="biografia-card-rule" aria-hidden="true" />
              <span class="biografia-card-label">{card.label}</span>
            </div>
            <div class="biografia-card-copy">
              <h2>{card.title}</h2>
              <p>{card.body}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="biografia-final-section relative" data-header-contrast="dark" aria-labelledby="biografia-final-title">
  <div class="biografia-final-viewport">
    <h2 id="biografia-final-title" class="biografia-final-title" aria-label={finalLines.join(" ")}>
      {
        finalLines.map((line, lineIndex) => (
          <span class={`biografia-final-line biografia-final-line-${lineIndex + 1}`} aria-hidden="true">
            {Array.from(line).map((character) => (
              <span class="biografia-final-char">{character === " " ? "\u00A0" : character}</span>
            ))}
          </span>
        ))
      }
    </h2>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  const FINAL_SCALE = 0.12;
  const SCROLL_DISTANCE_FACTOR = 0.9;
  const MOBILE_MEDIA_QUERY = "(max-width: 767px)";

  type BiografiaWindow = Window & {
    __biografiaCleanup?: () => void;
    __biografiaPageLoadHandler?: () => void;
    __biografiaBeforeSwapHandler?: () => void;
    __biografiaPreviousScrollRestoration?: ScrollRestoration;
  };

  const biografiaWindow = window as BiografiaWindow;

  function initMobileHorizontalScroll(): (() => void) | undefined {
    const horizontalSection = document.querySelector(".biografia-horizontal-section") as HTMLElement;
    const horizontalViewport = document.querySelector(".biografia-horizontal-viewport") as HTMLElement;
    const horizontalTrack = document.querySelector(".biografia-horizontal-track") as HTMLElement;
    const horizontalCards = Array.from(document.querySelectorAll(".biografia-card")) as HTMLElement[];

    if (!horizontalSection || !horizontalViewport || !horizontalTrack || horizontalCards.length !== 5) return;

    gsap.registerPlugin(ScrollTrigger);
    gsap.set(horizontalTrack, { autoAlpha: 1, scale: 1, transformOrigin: "50% 50%" });

    const horizontalStartX = () => horizontalViewport.clientWidth * 0.88;
    const horizontalEndX = () => {
      const lastCard = horizontalCards.at(-1);
      return lastCard ? -(lastCard.offsetLeft + lastCard.offsetWidth) : -horizontalTrack.scrollWidth;
    };
    const horizontalDistance = () => Math.max(horizontalStartX() - horizontalEndX(), window.innerWidth);

    const horizontalTl = gsap.timeline({
      scrollTrigger: {
        trigger: horizontalSection,
        start: "top top",
        end: () => `+=${Math.max(Math.round(horizontalDistance() * SCROLL_DISTANCE_FACTOR), window.innerWidth)}`,
        pin: true,
        pinSpacing: "margin",
        scrub: 1,
        anticipatePin: 1,
        invalidateOnRefresh: true
      }
    });

    horizontalTl.fromTo(horizontalTrack, { x: horizontalStartX }, { x: horizontalEndX, duration: 1, ease: "none" }, 0);
    ScrollTrigger.refresh();

    return () => {
      horizontalTl.scrollTrigger?.kill();
      horizontalTl.kill();
      gsap.set(horizontalTrack, { clearProps: "transform" });
    };
  }

  function initBiografiaScroll(): (() => void) | undefined {
    const introSection = document.querySelector("#biografia-hero") as HTMLElement;
    if (!introSection) return;

    // Hero and vertical cards stay in document flow on mobile. Only the
    // already-established horizontal card narrative keeps its scroll motion.
    if (window.matchMedia(MOBILE_MEDIA_QUERY).matches) {
      if (biografiaWindow.__biografiaPreviousScrollRestoration) {
        history.scrollRestoration = biografiaWindow.__biografiaPreviousScrollRestoration;
        delete biografiaWindow.__biografiaPreviousScrollRestoration;
      }
      document.documentElement.style.overflow = "";
      document.body.style.overflow = "";
      document.documentElement.style.overscrollBehavior = "";
      return initMobileHorizontalScroll() ?? (() => undefined);
    }

    gsap.registerPlugin(ScrollTrigger);

    const logoShell = introSection.querySelector(".biografia-logo-shell") as HTMLElement;
    const logoSvg = introSection.querySelector(".biografia-logo-svg") as HTMLElement;
    const letters = introSection.querySelectorAll(".bio-letter");
    const photoLayer = introSection.querySelector(".biografia-photo-layer") as HTMLElement;
    const photo = introSection.querySelector(".biografia-photo") as HTMLElement;
    const asideLayer = introSection.querySelector(".biografia-aside") as HTMLElement;
    const asideInner = introSection.querySelector(".biografia-aside-inner") as HTMLElement;
    const headerContainer = document.querySelector("[data-header-container]") as HTMLElement | null;
    const eyebrow = introSection.querySelector(".biografia-eyebrow") as HTMLElement;
    const title = introSection.querySelector(".biografia-title") as HTMLElement;
    const desc = introSection.querySelector(".biografia-desc") as HTMLElement;
    const verticalStage = introSection.querySelector(".biografia-vertical-stage") as HTMLElement;
    const verticalCards = Array.from(introSection.querySelectorAll(".biografia-vertical-card")) as HTMLElement[];
    const horizontalSection = document.querySelector(".biografia-horizontal-section") as HTMLElement;
    const horizontalViewport = document.querySelector(".biografia-horizontal-viewport") as HTMLElement;
    const horizontalTrack = document.querySelector(".biografia-horizontal-track") as HTMLElement;
    const horizontalCards = Array.from(document.querySelectorAll(".biografia-card")) as HTMLElement[];
    const finalSection = document.querySelector(".biografia-final-section") as HTMLElement;
    const finalTextChars = Array.from(document.querySelectorAll(".biografia-final-char")) as HTMLElement[];

    if (
      !logoShell ||
      !logoSvg ||
      !photoLayer ||
      !photo ||
      !asideLayer ||
      !asideInner ||
      !eyebrow ||
      !title ||
      !desc ||
      !verticalStage ||
      verticalCards.length !== 5 ||
      !horizontalSection ||
      !horizontalViewport ||
      !horizontalTrack ||
      horizontalCards.length !== 5 ||
      !finalSection ||
      finalTextChars.length === 0 ||
      letters.length === 0
    )
      return;

    const animations: gsap.core.Animation[] = [];
    const ownedTriggers: ScrollTrigger[] = [];
    const previousScrollRestoration = biografiaWindow.__biografiaPreviousScrollRestoration ?? history.scrollRestoration;
    const previousHtmlOverflow = document.documentElement.style.overflow;
    const previousBodyOverflow = document.body.style.overflow;
    const previousOverscrollBehavior = document.documentElement.style.overscrollBehavior;
    let active = true;

    function syncHeroContentLeft() {
      if (!headerContainer) return;
      const headerStyles = getComputedStyle(headerContainer);
      const headerRect = headerContainer.getBoundingClientRect();
      const headerContentLeft = headerRect.left + (Number.parseFloat(headerStyles.paddingLeft) || 0);
      asideInner.style.setProperty("--biografia-hero-content-left", `${headerContentLeft}px`);
    }

    function syncLogoColorWithStage() {
      const stageRect = verticalStage.getBoundingClientRect();
      const logoRect = logoSvg.getBoundingClientRect();
      const clipTop = getComputedStyle(verticalStage).clipPath.match(/^inset\(\s*(-?\d*\.?\d+)(%|px)?/i);
      const clipValue = clipTop ? Number.parseFloat(clipTop[1]) : 0;
      const clipOffset = clipTop?.[2] === "%" ? (clipValue / 100) * stageRect.height : clipValue;
      const visibleStageTop = stageRect.top + clipOffset;
      const logoCenterY = logoRect.top + logoRect.height / 2;
      const isOverDarkStage = logoCenterY >= visibleStageTop && logoCenterY <= stageRect.bottom;

      logoSvg.classList.toggle("is-white", isOverDarkStage);
    }

    syncHeroContentLeft();

    history.scrollRestoration = "manual";
    window.scrollTo({ top: 0, left: 0, behavior: "auto" });

    let titleChars: HTMLElement[] = [];
    if (title) {
      if (!title.dataset.split) {
        const nodes = Array.from(title.childNodes);
        title.innerHTML = "";
        nodes.forEach((node) => {
          if (node.nodeType === Node.TEXT_NODE) {
            for (const ch of node.textContent || "") {
              const span = document.createElement("span");
              span.textContent = ch;
              span.style.display = "inline-block";
              span.style.whiteSpace = "pre";
              title.appendChild(span);
            }
          } else if (node.nodeName === "BR") {
            title.appendChild(document.createElement("br"));
          } else {
            title.appendChild(node);
          }
        });
        title.dataset.split = "true";
      }
      titleChars = Array.from(title.querySelectorAll("span")) as HTMLElement[];
    }

    document.documentElement.style.overflow = "hidden";
    document.body.style.overflow = "hidden";
    document.documentElement.style.overscrollBehavior = "none";

    gsap.set(photo, { opacity: 0, y: 40, filter: "blur(0px)" });
    gsap.set(logoShell, { scale: 1, x: 0, y: 0, transformOrigin: "50% 50%" });
    gsap.set(letters, { opacity: 0, y: 30 });
    gsap.set([photoLayer, asideLayer], { autoAlpha: 1 });
    gsap.set(verticalStage, { clipPath: "inset(100% 0 0)" });
    gsap.set(verticalCards, { yPercent: 112, scale: 0.985 });
    gsap.set(horizontalTrack, { autoAlpha: 1, scale: 1, transformOrigin: "50% 50%" });
    gsap.set(finalTextChars, { opacity: 0.14, yPercent: 30 });
    logoSvg.classList.remove("is-white");

    if (eyebrow) gsap.set(eyebrow, { opacity: 0, y: 24 });
    if (titleChars.length) gsap.set(titleChars, { opacity: 0, x: -24 });
    if (desc) gsap.set(desc, { opacity: 0, y: 24 });

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let introFallbackId = 0;
    const introTl = gsap.timeline({
      onComplete: () => {
        window.clearTimeout(introFallbackId);
        if (!active) return;
        document.documentElement.style.overflow = previousHtmlOverflow;
        document.body.style.overflow = previousBodyOverflow;
        document.documentElement.style.overscrollBehavior = previousOverscrollBehavior;
        initScrollAnimations();
        ScrollTrigger.refresh();
      }
    });
    animations.push(introTl);

    // The intro locks scrolling until it finishes, but rAF is throttled while
    // the tab is backgrounded, which would leave the page unscrollable. Force
    // the timeline to settle if it has not finished on its own in time.
    introFallbackId = window.setTimeout(() => {
      if (active && introTl.progress() < 1) introTl.progress(1);
    }, 3200);

    introTl.to(letters, {
      opacity: 1,
      y: 0,
      duration: prefersReducedMotion ? 0.01 : 0.16,
      stagger: prefersReducedMotion ? 0.01 : 0.075,
      ease: "power1.out",
      delay: prefersReducedMotion ? 0.05 : 0.3
    });

    introTl.to(photo, { opacity: 1, y: 0, duration: prefersReducedMotion ? 0.1 : 0.9, ease: "power2.out" }, prefersReducedMotion ? ">" : "-=0.2");

    const getFinalScale = () => {
      if (window.innerWidth < 640) return 0.18;
      if (window.innerWidth < 1024) return 0.145;
      return FINAL_SCALE;
    };

    function computeTarget() {
      syncHeroContentLeft();
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      const finalScale = getFinalScale();
      const scaledW = logoShell.offsetWidth * finalScale;
      const scaledH = logoShell.offsetHeight * finalScale;

      // Align the visible wordmark edge with the actual text container edge.
      let targetLeft = Math.min(Math.max(vw * 0.07, 32), 144);
      const textAnchor = eyebrow.getBoundingClientRect().left;
      if (textAnchor >= 0) targetLeft = textAnchor;
      const logoVisualInset = (Number.parseFloat(getComputedStyle(logoShell).paddingLeft) || 0) * finalScale;
      const targetShellLeft = targetLeft - logoVisualInset;
      // Keep the shrunken wordmark clear of the fixed header (~112px tall)
      // instead of letting it tuck under the nav on shorter viewports.
      const targetTop = window.innerWidth < 1280 ? Math.max(vh * 0.13, 126) : Math.max(vh * 0.12, 92);

      const targetCenterX = targetShellLeft + scaledW / 2;
      const targetCenterY = targetTop + scaledH / 2;

      return { x: targetCenterX - vw / 2, y: targetCenterY - vh / 2 };
    }

    function initScrollAnimations() {
      const getCompactScale = () => {
        if (window.innerWidth < 640) return 0.68;
        if (window.innerWidth < 1024) return 0.6;
        return 0.5;
      };

      const getCompactY = () => (window.innerWidth < 1024 ? -window.innerHeight * 0.16 : 0);
      function addLogoTransition(timeline: gsap.core.Timeline) {
        timeline.addLabel("logoTransition", 0);
        timeline.to(photo, { filter: "blur(22px)", opacity: 0.42, duration: 0.52, ease: "none" }, "logoTransition");
        timeline.to(
          logoShell,
          {
            scale: () => getFinalScale(),
            x: () => computeTarget().x,
            y: () => computeTarget().y,
            duration: 0.56,
            ease: "power2.inOut"
          },
          "logoTransition"
        );
        timeline.to(photoLayer, { autoAlpha: 0, duration: 0.16, ease: "none" }, 0.52);
      }

      function addAsideReveal(timeline: gsap.core.Timeline) {
        timeline.addLabel("asideReveal", 0.6);
        timeline.to(eyebrow, { opacity: 1, y: 0, duration: 0.16, ease: "power2.out" }, "asideReveal");
        timeline.to(titleChars, { opacity: 1, x: 0, duration: 0.32, stagger: 0.014, ease: "power3.out" }, ">");
        timeline.to(desc, { opacity: 1, y: 0, duration: 0.2, ease: "power2.out" }, ">+0.08");
        timeline.to({}, { duration: 0.24 });
      }

      function addAsideTransformation(timeline: gsap.core.Timeline) {
        timeline.addLabel("asideTransform");
        timeline.to(asideInner, { scale: () => getCompactScale(), y: () => getCompactY(), duration: 0.62, ease: "power2.inOut" }, "asideTransform");
        timeline.to([eyebrow, title, desc], { color: "var(--biografia-stage-text)", duration: 0.62, ease: "none" }, "asideTransform");
        timeline.to(verticalStage, { clipPath: "inset(0% 0 0)", duration: 0.62, ease: "power2.inOut", onUpdate: syncLogoColorWithStage }, "asideTransform");
        timeline.to({}, { duration: 0.16 });
      }

      function addVerticalCards(timeline: gsap.core.Timeline) {
        verticalCards.forEach((card, index) => {
          const label = `verticalCard${index + 1}`;
          timeline.addLabel(label);

          if (index > 0) {
            timeline.to(verticalCards[index - 1], { yPercent: -112, scale: 0.965, duration: 0.52, ease: "power2.inOut" }, label);
          }

          timeline.to(card, { yPercent: 0, scale: 1, duration: 0.52, ease: "power2.out" }, label);
          timeline.to({}, { duration: index === verticalCards.length - 1 ? 0.62 : 0.3 });
        });
      }

      // Tablet, laptop and desktop all run the same pinned story so the hero
      // stays on screen for the whole reveal. Below 1280px the scroll budget is
      // slightly longer per beat, because the shorter viewport makes every
      // transition read faster.
      const storyTl = gsap.timeline({ paused: true });
      addLogoTransition(storyTl);
      addAsideReveal(storyTl);
      addAsideTransformation(storyTl);
      addVerticalCards(storyTl);

      const storyViewports = window.innerWidth < 1280 ? 10.5 : 9;
      const storyTrigger = ScrollTrigger.create({
        trigger: introSection,
        start: "top top",
        end: () =>
          `+=${Math.round(Math.max(window.innerHeight * storyViewports, storyTl.duration() * window.innerHeight) * SCROLL_DISTANCE_FACTOR)}`,
        pin: true,
        pinSpacing: "margin",
        scrub: 1,
        anticipatePin: 1,
        invalidateOnRefresh: true,
        animation: storyTl,
        onUpdate: syncLogoColorWithStage
      });
      animations.push(storyTl);
      ownedTriggers.push(storyTrigger);

      const horizontalStartX = () => horizontalViewport.clientWidth * (window.innerWidth < 1024 ? 0.88 : 0.78);
      const horizontalEndX = () => {
        const lastCard = horizontalCards.at(-1);
        return lastCard ? -(lastCard.offsetLeft + lastCard.offsetWidth) : -horizontalTrack.scrollWidth;
      };
      const horizontalDistance = () => Math.max(horizontalStartX() - horizontalEndX(), window.innerWidth);

      const horizontalTl = gsap.timeline({
        scrollTrigger: {
          trigger: horizontalSection,
          start: "top top",
          end: () => `+=${Math.max(Math.round(horizontalDistance() * SCROLL_DISTANCE_FACTOR), window.innerWidth)}`,
          pin: true,
          pinSpacing: "margin",
          scrub: 1,
          anticipatePin: 1,
          invalidateOnRefresh: true
        }
      });
      animations.push(horizontalTl);
      if (horizontalTl.scrollTrigger) ownedTriggers.push(horizontalTl.scrollTrigger);

      horizontalTl.fromTo(horizontalTrack, { x: horizontalStartX }, { x: horizontalEndX, duration: 1, ease: "none" }, 0);

      const finalTextTl = gsap.timeline({
        scrollTrigger: {
          trigger: finalSection,
          start: "top top",
          end: () => `+=${Math.round(Math.max(window.innerHeight * 2.2, finalTextChars.length * 42) * SCROLL_DISTANCE_FACTOR)}`,
          pin: true,
          pinSpacing: "margin",
          scrub: 1,
          anticipatePin: 1,
          invalidateOnRefresh: true
        }
      });
      animations.push(finalTextTl);
      if (finalTextTl.scrollTrigger) ownedTriggers.push(finalTextTl.scrollTrigger);

      finalTextTl.to(finalTextChars, {
        color: "var(--biografia-stage-text)",
        opacity: 1,
        yPercent: 0,
        duration: 0.34,
        stagger: 0.035,
        ease: "power2.out"
      });
      finalTextTl.to({}, { duration: 0.16 });
    }

    return () => {
      active = false;
      window.clearTimeout(introFallbackId);
      ownedTriggers.forEach((trigger) => trigger.kill());
      animations.forEach((animation) => animation.kill());
      logoSvg.classList.remove("is-white");
      document.documentElement.style.overflow = previousHtmlOverflow;
      document.body.style.overflow = previousBodyOverflow;
      document.documentElement.style.overscrollBehavior = previousOverscrollBehavior;
      history.scrollRestoration = previousScrollRestoration;
      delete biografiaWindow.__biografiaPreviousScrollRestoration;
    };
  }

  if (biografiaWindow.__biografiaPageLoadHandler) {
    document.removeEventListener("astro:page-load", biografiaWindow.__biografiaPageLoadHandler);
  }
  if (biografiaWindow.__biografiaBeforeSwapHandler) {
    document.removeEventListener("astro:before-swap", biografiaWindow.__biografiaBeforeSwapHandler);
  }

  biografiaWindow.__biografiaPageLoadHandler = () => {
    biografiaWindow.__biografiaCleanup?.();
    biografiaWindow.__biografiaCleanup = initBiografiaScroll();
  };
  biografiaWindow.__biografiaBeforeSwapHandler = () => {
    biografiaWindow.__biografiaCleanup?.();
    biografiaWindow.__biografiaCleanup = undefined;
  };

  document.addEventListener("astro:page-load", biografiaWindow.__biografiaPageLoadHandler);
  document.addEventListener("astro:before-swap", biografiaWindow.__biografiaBeforeSwapHandler);
</script>
