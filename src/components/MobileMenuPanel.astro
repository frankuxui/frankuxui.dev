---
// Rendered at the layout root (Root.astro), as a sibling of <Header>, <main>
// and <Footer> — NOT nested inside the header. The header uses
// `backdrop-blur-2xl`, and `backdrop-filter`/`filter`/`transform` on an
// ancestor creates a new containing block for `position: fixed` descendants,
// which was clipping this drawer to the header's small bounding box instead
// of the viewport. Keeping this component independent of the header avoids
// that trap. It only communicates with the toggle button
// (MobileMenuToggle.astro, rendered inside the header) through DOM ids, so
// the two can live anywhere in the tree.
const NAV_ITEMS = [
  { href: "/", label: "Inicio" },
  { href: "/sobre-mi", label: "Sobre mi" },
  { href: "/biografia", label: "Biografía" },
  { href: "/contacto", label: "Contacto" },
] as const;

const BLOG_URL = "https://frankuxui.com/blog";

const LEGAL_ITEMS = [
  { href: "/terminos-y-condiciones", label: "Términos y condiciones" },
  { href: "/politica-de-privacidad", label: "Política de privacidad" },
  { href: "/politica-de-cookies", label: "Política de cookies" },
] as const;
---

<div id="mobile-menu-root" class="mobile-menu-root fixed inset-0 z-[9999] md:hidden hidden" role="presentation" aria-hidden="true" transition:persist>
  <button
    type="button"
    id="mobile-menu-overlay"
    aria-label="Cerrar menu"
    class="mobile-menu-overlay absolute inset-0 h-full w-full bg-foreground/40 backdrop-blur-sm"
  ></button>

  <div
    id="mobile-menu-panel"
    role="dialog"
    aria-modal="true"
    aria-label="Menu principal"
    class="mobile-menu-panel absolute inset-x-3 bottom-3 flex flex-col rounded-4xl bg-background/95 backdrop-blur-2xl px-6 pb-[max(1.5rem,env(safe-area-inset-bottom))] shadow-2xl will-change-transform"
  >
    <button
      type="button"
      id="mobile-menu-drag-handle"
      aria-label="Redimensionar menu"
      class="mx-auto flex w-full touch-none cursor-ns-resize select-none items-center justify-center py-5"
    >
      <span class="h-1.5 w-14 rounded-full bg-foreground/20" aria-hidden="true"></span>
    </button>

    <div class="flex items-center justify-between px-1">
      <p class="inline-flex items-center rounded-full bg-secondary px-4 py-1.5 text-xs font-semibold uppercase tracking-wide text-secondary-foreground">Navegación</p>
      <button
        type="button"
        id="mobile-menu-close"
        class="inline-flex size-10 items-center justify-center rounded-full bg-secondary text-secondary-foreground transition-colors hover:bg-foreground hover:text-background"
        aria-label="Cerrar menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <nav class="mt-6 flex-1 overflow-y-auto" aria-label="Navegación móvil">
      <ul class="grid gap-3" id="mobile-menu-nav-list">
        {
          NAV_ITEMS.map((item, index) => (
            <li class="mobile-menu-nav-item" style={`transition-delay:${(0.2 + index * 0.06).toFixed(3)}s`}>
              <a
                href={item.href}
                data-nav-link
                data-href={item.href}
                class="flex min-h-14 items-center justify-between px-6 text-base font-semibold rounded-full bg-secondary/60 text-foreground transition-all duration-200 hover:bg-secondary data-[active=true]:bg-primary data-[active=true]:text-primary-foreground"
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="mobile-menu-nav-item" style={`transition-delay:${(0.2 + NAV_ITEMS.length * 0.06).toFixed(3)}s`}>
          <a
            href={BLOG_URL}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Blog (abre en nueva ventana)"
            class="flex min-h-14 items-center justify-between px-6 text-base font-semibold rounded-full bg-secondary/60 text-foreground transition-all duration-200 hover:bg-secondary"
          >
            Blog
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 21 21" aria-hidden="true">
              <path d="M0 0h21v21H0z" fill="none" />
              <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="M14.5 13.5v-7h-7m7 0l-8 8" />
            </svg>
          </a>
        </li>
      </ul>

      <div class="my-6 h-px w-full bg-foreground/10" role="separator"></div>

      <ul class="grid gap-1" id="mobile-menu-legal-list">
        {
          LEGAL_ITEMS.map((item, index) => (
            <li class="mobile-menu-nav-item" style={`transition-delay:${(0.2 + (NAV_ITEMS.length + 1 + index) * 0.06).toFixed(3)}s`}>
              <a
                href={item.href}
                data-nav-link
                data-href={item.href}
                class="flex min-h-11 items-center px-4 rounded-full text-sm font-medium text-foreground-muted transition-colors hover:bg-secondary/50 hover:text-foreground data-[active=true]:bg-secondary/60 data-[active=true]:text-foreground"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</div>

<script>
  import { trackAnalyticsEvent } from "@/lib/analytics";
  import { trapFocus } from "@/lib/focus-trap";

  function getPathname() {
    return window.location.pathname.replace(/\/+$/, "") || "/";
  }

  function setup() {
    const toggleBtn = document.getElementById("mobile-menu-toggle") as HTMLButtonElement | null;
    const root = document.getElementById("mobile-menu-root");
    const overlay = document.getElementById("mobile-menu-overlay") as HTMLButtonElement | null;
    const panel = document.getElementById("mobile-menu-panel") as HTMLDivElement | null;
    const dragHandle = document.getElementById("mobile-menu-drag-handle") as HTMLButtonElement | null;
    const closeBtn = document.getElementById("mobile-menu-close") as HTMLButtonElement | null;
    const navLinks = document.querySelectorAll<HTMLAnchorElement>("#mobile-menu-nav-list [data-nav-link]");

    if (!toggleBtn || !root || !overlay || !panel || !dragHandle || !closeBtn) return;

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let isOpen = false;
    let isClosing = false;
    let isDragging = false;
    let dragStartY = 0;
    let dragStartTranslate = 0;
    let panelHeight = 0;
    let releaseFocusTrap: (() => void) | null = null;

    function highlightActiveLink() {
      const pathname = getPathname();
      navLinks.forEach((link) => {
        const href = (link.dataset.href ?? "").replace(/\/+$/, "") || "/";
        link.dataset.active = href === pathname ? "true" : "false";
      });
    }

    function onKeydown(event: KeyboardEvent) {
      if (event.key === "Escape") closeMenu();
    }

    function openMenu() {
      if (isOpen) return;
      isOpen = true;
      highlightActiveLink();
      root.classList.remove("hidden");
      root.setAttribute("aria-hidden", "false");
      toggleBtn.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";

      // 1) Commit the "closed" (off-screen) state with transitions disabled,
      // right as the panel becomes visible (display: none -> block).
      panel.style.transition = "none";
      panel.style.transform = "translateY(120%)";
      overlay.style.transition = "none";
      overlay.classList.remove("mobile-menu-overlay-visible");

      // 2) Force a synchronous layout/style flush so the browser registers
      // the state above as the animation's starting point. Without this,
      // some browsers collapse the display-change + transform-change into a
      // single paint and the panel simply appears already open, instead of
      // sliding up from the bottom.
      void panel.offsetHeight;

      // 3) Re-enable transitions and set the final (open) state.
      panel.style.transition = "";
      overlay.style.transition = "";
      panel.classList.add("mobile-menu-panel-open");
      overlay.classList.add("mobile-menu-overlay-visible");
      panel.style.transform = "translateY(0)";

      window.setTimeout(() => closeBtn.focus(), prefersReducedMotion ? 0 : 260);
      releaseFocusTrap = trapFocus(panel);
      document.addEventListener("keydown", onKeydown);
      trackAnalyticsEvent("mobile_menu_toggle", { action: "open", location: "header" });
    }

    function closeMenu(targetHref?: string, reason: "overlay" | "button" | "drag" | "nav" = "button") {
      if (!isOpen || isClosing) return;
      isClosing = true;
      trackAnalyticsEvent("mobile_menu_close", { reason });

      overlay.classList.remove("mobile-menu-overlay-visible");
      panel.classList.remove("mobile-menu-panel-open");
      panel.style.transition = "";
      panel.style.transform = "translateY(120%)";

      document.removeEventListener("keydown", onKeydown);
      releaseFocusTrap?.();
      releaseFocusTrap = null;

      window.setTimeout(
        () => {
          root.classList.add("hidden");
          root.setAttribute("aria-hidden", "true");
          toggleBtn.setAttribute("aria-expanded", "false");
          document.body.style.overflow = "";
          isOpen = false;
          isClosing = false;

          if (targetHref) {
            window.location.assign(targetHref);
          } else {
            toggleBtn.focus();
          }
        },
        prefersReducedMotion ? 0 : 300
      );
    }

    toggleBtn.addEventListener("click", () => {
      if (isOpen) {
        closeMenu(undefined, "button");
      } else {
        openMenu();
      }
    });

    overlay.addEventListener("click", () => closeMenu(undefined, "overlay"));
    closeBtn.addEventListener("click", () => closeMenu(undefined, "button"));

    navLinks.forEach((link) => {
      link.addEventListener("click", (event) => {
        event.preventDefault();
        const href = link.dataset.href ?? link.getAttribute("href") ?? "/";
        trackAnalyticsEvent("navigation_click", { location: "mobile_menu", label: link.textContent?.trim(), href });
        closeMenu(href, "nav");
      });
    });

    function onDragStart(event: PointerEvent) {
      if (prefersReducedMotion || isClosing) return;
      isDragging = true;
      panelHeight = panel.getBoundingClientRect().height;
      dragStartY = event.clientY;
      dragStartTranslate = 0;
      panel.style.transition = "none";
      dragHandle.setPointerCapture(event.pointerId);
    }

    function onDragMove(event: PointerEvent) {
      if (!isDragging) return;
      const delta = Math.max(0, event.clientY - dragStartY + dragStartTranslate);
      panel.style.transform = `translateY(${delta}px)`;
    }

    function onDragEnd(event: PointerEvent) {
      if (!isDragging) return;
      isDragging = false;
      if (dragHandle.hasPointerCapture(event.pointerId)) {
        dragHandle.releasePointerCapture(event.pointerId);
      }

      const delta = Math.max(0, event.clientY - dragStartY);
      panel.style.transition = "";

      if (panelHeight > 0 && delta > panelHeight * 0.32) {
        closeMenu(undefined, "drag");
      } else {
        panel.style.transform = "translateY(0)";
      }
    }

    dragHandle.addEventListener("pointerdown", onDragStart);
    dragHandle.addEventListener("pointermove", onDragMove);
    dragHandle.addEventListener("pointerup", onDragEnd);
    dragHandle.addEventListener("pointercancel", onDragEnd);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setup);
  } else {
    setup();
  }
</script>

<style>
  .mobile-menu-panel {
    height: 50dvh;
    transform: translateY(120%);
    transition: transform 0.32s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .mobile-menu-overlay {
    opacity: 0;
    transition: opacity 0.28s ease;
  }

  .mobile-menu-overlay-visible {
    opacity: 1;
  }

  .mobile-menu-nav-item {
    opacity: 0;
    transform: translate(-12px, 18px);
    transition: opacity 0.32s cubic-bezier(0.22, 1, 0.36, 1), transform 0.32s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .mobile-menu-panel-open .mobile-menu-nav-item {
    opacity: 1;
    transform: translate(0, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu-panel,
    .mobile-menu-overlay,
    .mobile-menu-nav-item {
      transition-duration: 0.01ms !important;
    }
  }
</style>
