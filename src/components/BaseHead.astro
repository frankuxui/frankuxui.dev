---
import { siteConfig } from "@/config";

interface Props {
  title: string;
  description: string;
  image?: string;
  keywords?: string;
}

// Normalizar Astro.url.pathname para quitar trailing slash (menos para "/")
const pathname =
  Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/$/, "");

// Crear la URL canónica normalizada
const canonicalURL = new URL(pathname, Astro.site).toString();
const {
  title,
  description,
  image = siteConfig.openGraph.image,
  keywords = siteConfig.keywords,
} = Astro.props as Props;
const ogImage = new URL(image, Astro.site?.href || "https://frankuxui.dev")
  .href;

const siteUrl = (Astro.site?.href || siteConfig.siteUrl).replace(/\/$/, "");
const sameAs = [
  siteConfig.social.github,
  siteConfig.social.linkedin,
  siteConfig.social.figma,
  siteConfig.social.codepen,
  siteConfig.social.codesandbox,
  siteConfig.social.devto,
  siteConfig.social.instagram,
  siteConfig.social.dribbble,
  siteConfig.social.facebook,
  "https://frankuxui.com",
];
const authorImage = new URL(siteConfig.openGraph.image, Astro.site).toString();
const logoUrl = new URL(siteConfig.logo, Astro.site).toString();

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${siteUrl}#person`,
  name: siteConfig.authorName,
  alternateName: siteConfig.alternateNames,
  url: siteUrl,
  image: authorImage,
  jobTitle: siteConfig.jobTitle,
  description: siteConfig.description,
  sameAs,
  knowsAbout: siteConfig.knowsAbout,
  worksFor: { "@id": `${siteUrl}#studio` },
  contactPoint: [
    {
      "@type": "ContactPoint",
      email: `mailto:${siteConfig.contact.email}`,
      telephone: siteConfig.contact.phone,
      contactType: "customer service",
      areaServed: "ES",
      availableLanguage: ["es", "en", "ca"],
    },
  ],
  address: {
    "@type": "PostalAddress",
    streetAddress: siteConfig.address.street,
    addressLocality: siteConfig.address.locality,
    addressRegion: siteConfig.address.region,
    postalCode: siteConfig.address.postalCode,
    addressCountry: siteConfig.address.country,
  },
};

const professionalServiceSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${siteUrl}#studio`,
  name: `${siteConfig.authorName} · ${siteConfig.siteName}`,
  url: siteUrl,
  image: authorImage,
  logo: logoUrl,
  description: siteConfig.description,
  areaServed: [
    { "@type": "City", name: siteConfig.address.locality },
    { "@type": "Country", name: "España", identifier: "ES" },
  ],
  founder: { "@id": `${siteUrl}#person` },
  sameAs,
  contactPoint: [
    {
      "@type": "ContactPoint",
      email: `mailto:${siteConfig.contact.email}`,
      telephone: siteConfig.contact.phone,
      contactType: "sales",
      areaServed: "ES",
      availableLanguage: ["es", "en", "ca"],
    },
  ],
  address: {
    "@type": "PostalAddress",
    streetAddress: siteConfig.address.street,
    addressLocality: siteConfig.address.locality,
    addressRegion: siteConfig.address.region,
    postalCode: siteConfig.address.postalCode,
    addressCountry: siteConfig.address.country,
  },
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${siteUrl}#organization`,
  name: siteConfig.siteName,
  legalName: siteConfig.authorName,
  url: siteUrl,
  logo: logoUrl,
  slogan: "Experiencias digitales enfocadas en UX, frontend y SEO técnico.",
  sameAs,
  founder: { "@id": `${siteUrl}#person` },
  contactPoint: [
    {
      "@type": "ContactPoint",
      email: `mailto:${siteConfig.contact.email}`,
      telephone: siteConfig.contact.phone,
      contactType: "press",
    },
  ],
  address: {
    "@type": "PostalAddress",
    streetAddress: siteConfig.address.street,
    addressLocality: siteConfig.address.locality,
    addressRegion: siteConfig.address.region,
    postalCode: siteConfig.address.postalCode,
    addressCountry: siteConfig.address.country,
  },
};

const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}#website`,
  url: siteUrl,
  name: siteConfig.siteName,
  inLanguage: siteConfig.locale,
  publisher: { "@id": `${siteUrl}#studio` },
  sameAs,
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta
  name="description"
  content="Frank Esteban — Frontend Developer y Diseñador UX/UI con más de 8 años de experiencia creando interfaces intuitivas, accesibles y modernas. Disponible para nuevos proyectos."
/>

<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="apple-touch-icon" sizes="57x57" href="/apple-touch-icon-57x57.png" />
<link rel="apple-touch-icon" sizes="72x72" href="/apple-touch-icon-72x72.png" />
<link rel="apple-touch-icon" sizes="76x76" href="/apple-touch-icon-76x76.png" />
<link
  rel="apple-touch-icon"
  sizes="114x114"
  href="/apple-touch-icon-114x114.png"
/>
<link
  rel="apple-touch-icon"
  sizes="120x120"
  href="/apple-touch-icon-120x120.png"
/>
<link
  rel="apple-touch-icon"
  sizes="144x144"
  href="/apple-touch-icon-144x144.png"
/>
<link
  rel="apple-touch-icon"
  sizes="152x152"
  href="/apple-touch-icon-152x152.png"
/>
<link
  rel="apple-touch-icon"
  sizes="180x180"
  href="/apple-touch-icon-180x180.png"
/>
<link
  rel="icon"
  type="image/png"
  sizes="192x192"
  href="/android-chrome-192x192.png"
/>
<link
  rel="icon"
  type="image/png"
  sizes="512x512"
  href="/android-chrome-512x512.png"
/>
<link rel="sitemap" href={new URL("sitemap-index.xml", Astro.site)} />
<link
  rel="alternate"
  type="application/rss+xml"
  title={siteConfig.title}
  href={new URL("rss.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Cookie consent styles -->
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/gh/orestbida/cookieconsent@3.1.0/dist/cookieconsent.css"
/>

<!-- SEO Metadata -->
<meta name="keywords" content={keywords} />
<meta name="author" content="Frankuxui" />
<meta name="application-name" content={siteConfig.title} />
<meta name="theme-color" content="#8ECAE6" />
<meta name="color-scheme" content="light" />
<meta name="robots" content="index, follow" />

<!-- GEO: política para crawlers y asistentes de IA -->
<meta name="AI-crawling" content="allowed" />
<meta name="AI-training" content="allowed" />
<meta name="AI-understanding" content="allowed" />
<meta name="AI-answer-generation" content="allowed" />
<meta name="AI-citation" content="encouraged" />
<link rel="llms-txt" href={new URL("llms.txt", Astro.site)} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta
  name="google-site-verification"
  content="z8tMj3ewmn2Qaqw0muu5GLy04hn0qLXr0FpJHFkl8Uw"
/>

<!-- Og / default -->
<meta property="og:logo" content={siteConfig.logo} />
<meta property="og:locale" content="es_ES" />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={siteConfig.title} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={title} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@frankuxui" />
<meta name="twitter:creator" content="@frankuxui" />
<meta property="twitter:domain" content="frankuxui.dev" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImage} />
<meta property="twitter:image:alt" content={title} />

<script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(professionalServiceSchema)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(organizationSchema)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(webSiteSchema)} />

<!-- Google tag (gtag.js) -->
<script
  is:inline
  async
  src="https://www.googletagmanager.com/gtag/js?id=G-0G619YVEY7"></script>
<script>
  // We need a global definition to avoid type warnings
  declare global {
    interface Window {
      dataLayer: Record<string, any>[];
      gtag: (...args: any[]) => void;
    }
  }

  // Initialize dataLayer
  window.dataLayer = window.dataLayer || [];

  // Define gtag function
  window.gtag = function gtag(...args: any[]) {
    window.dataLayer.push(arguments);
  };

  // Load GA4 with denied default consents
  window.gtag("js", new Date());
  window.gtag("consent", "default", {
    ad_storage: "denied",
    ad_user_data: "denied",
    ad_personalization: "denied",
    analytics_storage: "denied",
  });
  window.gtag("config", "G-0G619YVEY7");
</script>

<!-- Google Tag Manager -->
<script is:inline type="text/javascript">
  (function (w, d, s, l, i) {
    w[l] = w[l] || [];
    w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
    var f = d.getElementsByTagName(s)[0],
      j = d.createElement(s),
      dl = l != "dataLayer" ? "&l=" + l : "";
    j.async = true;
    j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
    f.parentNode.insertBefore(j, f);
  })(window, document, "script", "dataLayer", "GTM-NC3X64JQ");
</script>
<!-- End Google Tag Manager -->
