---
// Hamburger button that lives in the header. The drawer it controls
// (MobileMenuPanel.astro) is rendered independently at the layout root
// (see Root.astro) so it never inherits a stacking/containing-block
// context from the header — they only talk to each other via DOM ids,
// so keeping them in separate components is safe.
---

<button
  type="button"
  id="mobile-menu-toggle"
  data-toggle="drawer-menu"
  aria-expanded="false"
  aria-controls="mobile-navigation"
  aria-label="Abrir menu"
  class="inline-flex flex-none md:hidden size-12 items-center justify-center cursor-pointer rounded-full text-foreground transition-all duration-200 hover:bg-white hover:text-foreground"
>
  <svg xmlns="http://www.w3.org/2000/svg" class="size-12" viewBox="0 0 24 24">
    <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2.6" d="M9.41 9.66H9.4m5.2 0h-.01m-5.28 4.7H9.3m5.3 0h-.01"></path>
  </svg>
</button>
