---
const palettes = [
  {
    id: "refreshing-summer-fun",
    name: "Refreshing Summer Fun",
    colors: {
      background: "#ffb703",
      foreground: "#023047",
      primary: "#3055c2",
      secondary: "#8ecae6",
      tertiary: "#fb8500"
    }
  },
  {
    id: "sunny-beach-day",
    name: "Sunny Beach Day",
    colors: {
      background: "#e9c46a",
      foreground: "#264653",
      primary: "#2a9d8f",
      secondary: "#f4a261",
      tertiary: "#e76f51"
    }
  },
  {
    id: "mystic-evening",
    name: "Mystic Evening",
    colors: {
      background: "#eacdc2",
      foreground: "#1a1423",
      primary: "#372549",
      secondary: "#774c60",
      tertiary: "#b75d69"
    }
  },
  {
    id: "ocean-sunset",
    name: "Ocean Sunset",
    colors: {
      background: "#f4d58d",
      foreground: "#001427",
      primary: "#8d0801",
      secondary: "#bf0603",
      tertiary: "#708d81"
    }
  },
  {
    id: "asteroid-impact",
    name: "Asteroid Impact",
    colors: {
      background: "#f2f0f1",
      foreground: "#0b070a",
      primary: "#30428c",
      secondary: "#fe4f3e",
      tertiary: "#18b5ec"
    }
  },
  {
    id: "neutral-earthtones",
    name: "Neutral Earthtones",
    colors: {
      background: "#EAE0D5",
      foreground: "#0A0908",
      primary: "#fb6107",
      secondary: "#5E503F",
      tertiary: "#C6AC8F"
    }
  },
  {
    id: "sunset-beach-escape",
    name: "Sunset Beach Escape",
    colors: {
      background: "#f4f7be",
      foreground: "#1e000e",
      primary: "#823038",
      secondary: "#e5f77d",
      tertiary: "#deba6f"
    }
  },
  {
    id: "warm-autumn-glow",
    name: "Warm Autumn Glow",
    colors: {
      background: "#003049",
      foreground: "#eae2b7",
      primary: "#d62828",
      secondary: "#f77f00",
      tertiary: "#fcbf49"
    }
  }
];
---

<div id="palette-modal-wrapper" class="fixed inset-0 z-[90] hidden items-center justify-center p-4 sm:p-6" aria-hidden="true">
  <button class="absolute inset-0 bg-black/70 cursor-default" type="button" data-toggle="palette-modal-close" aria-label="Cerrar selector de paletas"></button>

  <section
    id="palette-modal"
    class="palette-modal-content relative z-10 w-full max-w-4xl border-2 border-foreground bg-background shadow-[8px_8px_0px_var(--color-foreground)] opacity-0"
    role="dialog"
    aria-modal="true"
    aria-labelledby="palette-modal-title"
    tabindex="-1"
  >
    <header class="flex items-start justify-between gap-6 border-b-2 border-foreground px-5 py-5 sm:px-8">
      <div>
        <p class="text-sm font-medium uppercase opacity-75">Personaliza la web</p>
        <h2 id="palette-modal-title" class="mt-1 text-2xl font-bold sm:text-3xl">Temas y paletas</h2>
      </div>

      <button
        class="inline-flex size-11 flex-none cursor-pointer items-center justify-center border-2 border-foreground bg-background shadow-[3px_3px_0px_var(--color-foreground)] motion-safe:transition-all duration-200 hover:translate-x-0.5 hover:translate-y-0.5 hover:shadow-[1px_1px_0px_var(--color-foreground)]"
        type="button"
        data-toggle="palette-modal-close"
        aria-label="Cerrar selector de paletas"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="size-6" viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="currentColor"
            d="m12 13.4l-4.9 4.9q-.275.275-.7.275t-.7-.275t-.275-.7t.275-.7l4.9-4.9l-4.9-4.9q-.275-.275-.275-.7t.275-.7t.7-.275t.7.275l4.9 4.9l4.9-4.9q.275-.275.7-.275t.7.275t.275.7t-.275.7L13.4 12l4.9 4.9q.275.275.275.7t-.275.7t-.7.275t-.7-.275z"
          ></path>
        </svg>
      </button>
    </header>

    <div class="max-h-[min(70vh,42rem)] overflow-y-auto px-5 py-6 sm:px-8">
      <div class="grid gap-4 sm:grid-cols-2">
        {
          palettes.map((palette) => {
            const style = `--palette-background:${palette.colors.background};--palette-foreground:${palette.colors.foreground};--palette-primary:${palette.colors.primary};--palette-secondary:${palette.colors.secondary};--palette-tertiary:${palette.colors.tertiary};`;

            return (
              <button
                class="palette-card group flex min-h-48 cursor-pointer flex-col justify-between border-2 border-foreground p-5 text-left shadow-[5px_5px_0px_var(--color-foreground)] motion-safe:transition-all duration-200 hover:translate-x-1 hover:translate-y-1 hover:shadow-[2px_2px_0px_var(--color-foreground)] data-[state='active']:translate-x-1 data-[state='active']:translate-y-1 data-[state='active']:shadow-[2px_2px_0px_var(--color-foreground)]"
                type="button"
                style={style}
                data-palette-option={palette.id}
                aria-pressed="false"
              >
                <span class="flex items-start justify-between gap-4">
                  <span>
                    <span class="block text-xl font-bold">{palette.name}</span>
                    <span class="mt-1 block text-sm opacity-75">{palette.id}</span>
                  </span>
                  <span
                    class="palette-check inline-flex size-8 flex-none items-center justify-center border-2 border-current opacity-0 motion-safe:transition-opacity group-data-[state='active']:opacity-100"
                    aria-hidden="true"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24">
                      <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4" d="m5 12l4.5 4.5L19 7" />
                    </svg>
                  </span>
                </span>

                <span class="mt-8 flex h-16 overflow-hidden border-2 border-current" aria-hidden="true">
                  <span class="block flex-1 bg-[var(--palette-background)]" />
                  <span class="block flex-1 bg-[var(--palette-foreground)]" />
                  <span class="block flex-1 bg-[var(--palette-primary)]" />
                  <span class="block flex-1 bg-[var(--palette-secondary)]" />
                  <span class="block flex-1 bg-[var(--palette-tertiary)]" />
                </span>
              </button>
            );
          })
        }
      </div>
    </div>
  </section>
</div>

<script>
  const paletteStorageKey = "frankuxui-palette";
  const defaultPalette = "ocean-sunset";

  function getCurrentPalette() {
    return document.documentElement.dataset.palette || defaultPalette;
  }

  function setPalette(palette: string) {
    document.documentElement.dataset.palette = palette;
    localStorage.setItem(paletteStorageKey, palette);
    updateSelectedPalette(palette);
  }

  function updateSelectedPalette(palette = getCurrentPalette()) {
    const paletteOptions = document.querySelectorAll("[data-palette-option]") as NodeListOf<HTMLButtonElement>;

    paletteOptions.forEach((option) => {
      const isActive = option.dataset.paletteOption === palette;
      option.dataset.state = isActive ? "active" : "";
      option.setAttribute("aria-pressed", String(isActive));
    });
  }

  function setupPaletteModal() {
    const wrapper = document.querySelector("#palette-modal-wrapper") as HTMLElement | null;
    const modal = document.querySelector("#palette-modal") as HTMLElement | null;
    const triggers = document.querySelectorAll("[data-toggle='palette-modal']");
    const closeTriggers = document.querySelectorAll("[data-toggle='palette-modal-close']");
    const paletteOptions = document.querySelectorAll("[data-palette-option]") as NodeListOf<HTMLButtonElement>;
    const storedPalette = localStorage.getItem(paletteStorageKey);
    let lastFocusedElement: Element | null = null;

    if (!wrapper || !modal || !triggers.length) return;

    if (storedPalette) {
      document.documentElement.dataset.palette = storedPalette;
    }

    updateSelectedPalette();

    function openModal() {
      lastFocusedElement = document.activeElement;
      wrapper?.classList.remove("hidden");
      wrapper?.classList.add("flex", "palette-modal-open");
      wrapper?.setAttribute("aria-hidden", "false");
      document.body.classList.add("overflow-hidden");
      modal?.focus();
    }

    function closeModal() {
      wrapper?.classList.remove("palette-modal-open");
      wrapper?.classList.add("palette-modal-close");

      wrapper?.addEventListener(
        "animationend",
        () => {
          wrapper?.classList.remove("flex", "palette-modal-close");
          wrapper?.classList.add("hidden");
          wrapper?.setAttribute("aria-hidden", "true");
          document.body.classList.remove("overflow-hidden");

          if (lastFocusedElement instanceof HTMLElement) {
            lastFocusedElement.focus();
          }
        },
        { once: true }
      );
    }

    triggers.forEach((trigger) => {
      trigger.addEventListener("click", openModal);
    });

    closeTriggers.forEach((trigger) => {
      trigger.addEventListener("click", closeModal);
    });

    paletteOptions.forEach((option) => {
      option.addEventListener("click", () => {
        const palette = option.dataset.paletteOption;
        if (!palette) return;

        setPalette(palette);
      });
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !wrapper.classList.contains("hidden")) {
        closeModal();
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupPaletteModal);
  } else {
    setupPaletteModal();
  }
</script>

<style>
  .palette-card {
    background: var(--palette-background);
    color: var(--palette-foreground);
  }

  .palette-check {
    background: var(--palette-foreground);
    color: var(--palette-background);
  }

  .palette-modal-open .palette-modal-content {
    animation: palette-modal-in 180ms ease-out forwards;
  }

  .palette-modal-close .palette-modal-content {
    animation: palette-modal-out 150ms ease-in forwards;
  }

  @keyframes palette-modal-in {
    from {
      opacity: 0;
      transform: translateY(1rem) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes palette-modal-out {
    from {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    to {
      opacity: 0;
      transform: translateY(1rem) scale(0.98);
    }
  }
</style>
