---
import type { Note } from "@/types/Note";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

const notes = await getCollection("notes", ({ data }: CollectionEntry<"notes">) => (import.meta.env.PROD ? !data.draft : true));
const sortedNotes = notes.sort((a: CollectionEntry<"notes">, b: CollectionEntry<"notes">) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 5);

const notesData = sortedNotes.map((note: Note) => ({
  id: note.id,
  title: note.data.title,
  description: note.data.description,
  icon: note.data.icon,
  accentColor: note.data.accentColor,
  tags: note.data.tags
}));
---

<!-- Backdrop -->
<div id="searchModalBackdrop" class="fixed inset-0 z-[998] bg-white/40 backdrop-blur-sm pointer-events-none" style="visibility: hidden; opacity: 0;" aria-hidden="true"></div>

<!-- Modal -->
<div
  id="searchModalPanel"
  class="fixed z-[999] inset-0 flex items-start justify-center pointer-events-none pt-[12vh] sm:pt-[16vh] px-4"
  style="visibility: hidden; opacity: 0;"
  role="dialog"
  aria-modal="true"
  aria-label="Buscar notas"
>
  <div id="searchModalContent" class="w-full max-w-2xl rounded-3xl bg-white/80 backdrop-blur-2xl shadow-2xl shadow-black/8 overflow-hidden pointer-events-auto" style="transform: translateY(20px);">
    <!-- Search input -->
    <div class="flex items-center gap-4 px-7 h-16 border-b border-foreground/5">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="size-5 flex-none text-foreground/70"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        id="searchModalInput"
        type="text"
        placeholder="Buscar nota..."
        autocomplete="off"
        role="combobox"
        aria-expanded="false"
        aria-controls="searchModalList"
        aria-autocomplete="list"
        aria-activedescendant=""
        class="flex-1 h-full bg-transparent text-base text-foreground placeholder:text-foreground/30 border-0 outline-none placeholder:text-base placeholder:font-normal font-medium"
      />
      <kbd class="hidden sm:inline-flex items-center gap-0.5 px-2 h-7 rounded-lg bg-foreground/5 text-xs font-mono text-foreground/40 select-none">esc</kbd>
    </div>

    <!-- Notes list -->
    <div id="searchModalScroll" class="max-h-[55vh] overflow-y-auto">
      <ul id="searchModalList" class="flex flex-col gap-1 pt-2" role="listbox" aria-label="Notas">
        {
          sortedNotes.map((note: Note, i: number) => (
            <li id={`search-option-${i}`} role="option" aria-selected="false" data-index={i}>
              <a href={`/notas/${note.id}`} class="search-modal-item flex items-center gap-4 px-4 py-4 rounded-2xl text-foreground transition-colors duration-150" tabindex="-1">
                <div class="min-w-0 flex-1">
                  <span class="block text-base font-semibold leading-snug">{note.data.title}</span>
                  <span class="block text-sm text-foreground/50 leading-relaxed mt-1 line-clamp-1">{note.data.description}</span>
                </div>
                <span class="flex-none size-11 rounded-2xl flex items-center justify-center text-xl" style={`background-color: ${note.data.accentColor}20;`} aria-hidden="true">
                  {note.data.icon}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <div id="searchModalEmpty" class="hidden px-4 py-20 text-center text-sm">
        <div class="w-full mx-auto text-center">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="32"
            height="32"
            viewBox="0 0 24 24"
            class="mx-auto"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M12 22v-9"></path><path d="M15.17 2.21a1.67 1.67 0 0 1 1.63 0L21 4.57a1.93 1.93 0 0 1 0 3.36L8.82 14.79a1.655 1.655 0 0 1-1.64 0L3 12.43a1.93 1.93 0 0 1 0-3.36z"></path><path
              d="M20 13v3.87a2.06 2.06 0 0 1-1.11 1.83l-6 3.08a1.93 1.93 0 0 1-1.78 0l-6-3.08A2.06 2.06 0 0 1 4 16.87V13"></path><path
              d="M21 12.43a1.93 1.93 0 0 0 0-3.36L8.83 2.2a1.64 1.64 0 0 0-1.63 0L3 4.57a1.93 1.93 0 0 0 0 3.36l12.18 6.86a1.636 1.636 0 0 0 1.63 0z"></path></svg
          >
        </div>
        <div class="text-foreground/50 mt-2">Sin resultados</div>
      </div>
    </div>

    <!-- Footer -->
    <div class="px-3 pt-3 pb-6 border-t border-foreground/5">
      <div class="flex items-center justify-between px-4 pt-3">
        <div class="hidden sm:flex items-center gap-3 text-xs text-foreground/35">
          <span class="inline-flex items-center gap-1">
            <kbd class="px-1.5 py-0.5 rounded-md bg-foreground/5 font-mono text-[11px]">&uarr;</kbd>
            <kbd class="px-1.5 py-0.5 rounded-md bg-foreground/5 font-mono text-[11px]">&darr;</kbd>
            navegar
          </span>
          <span class="inline-flex items-center gap-1">
            <kbd class="px-1.5 py-0.5 rounded-md bg-foreground/5 font-mono text-[11px]">&crarr;</kbd>
            abrir
          </span>
        </div>
        <a href="/notas" class="search-modal-item inline-flex items-center gap-1.5 text-sm font-medium text-foreground/50 hover:text-foreground transition-colors duration-150">
          Ver todas
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="size-3.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ notesData: JSON.stringify(notesData) }}>
  window.__searchModalNotes = JSON.parse(notesData);
</script>

<script>
  import { gsap } from "gsap";
  import Fuse from "fuse.js";

  interface NoteItem {
    id: string;
    title: string;
    description: string;
    icon: string;
    accentColor: string;
    tags: string[];
  }

  declare global {
    interface Window {
      __searchModalNotes?: NoteItem[];
    }
  }

  let searchModalAc: AbortController | null = null;

  function initSearchModal(): void {
    const backdrop = document.getElementById("searchModalBackdrop") as HTMLDivElement | null;
    const panel = document.getElementById("searchModalPanel") as HTMLDivElement | null;
    const content = document.getElementById("searchModalContent") as HTMLDivElement | null;
    const input = document.getElementById("searchModalInput") as HTMLInputElement | null;
    const list = document.getElementById("searchModalList") as HTMLUListElement | null;
    const emptyMsg = document.getElementById("searchModalEmpty") as HTMLDivElement | null;

    if (!backdrop || !panel || !content || !input || !list) return;

    searchModalAc?.abort();
    searchModalAc = new AbortController();
    const { signal } = searchModalAc;

    const portal = document.getElementById("popover-portal");
    if (portal) {
      if (backdrop.parentElement !== portal) portal.appendChild(backdrop);
      if (panel.parentElement !== portal) portal.appendChild(panel);
    }

    const allNotes: NoteItem[] = window.__searchModalNotes ?? [];

    const fuse = new Fuse<NoteItem>(allNotes, {
      keys: [
        { name: "title", weight: 0.5 },
        { name: "description", weight: 0.3 },
        { name: "tags", weight: 0.2 }
      ],
      threshold: 0.25,
      ignoreLocation: true,
      minMatchCharLength: 2
    });

    let isOpen = false;
    let activeIndex = -1;
    let visibleItems: HTMLLIElement[] = [];

    function escapeHTML(str: string): string {
      const div = document.createElement("div");
      div.textContent = str;
      return div.innerHTML;
    }

    function buildItemHTML(note: NoteItem, index: number): string {
      return `<li id="search-option-${index}" role="option" aria-selected="false" data-index="${index}">
        <a href="/notas/${note.id}" class="search-modal-item flex items-center gap-4 p-6 text-foreground transition-colors duration-150" tabindex="-1">
          <div class="min-w-0 flex-1">
            <span class="block text-base font-semibold leading-snug">${escapeHTML(note.title)}</span>
            <span class="block text-sm text-foreground/80 leading-relaxed mt-1 line-clamp-1">${escapeHTML(note.description)}</span>
          </div>
          <span class="flex-none size-11 rounded-2xl flex items-center justify-center text-xl" style="background-color: ${note.accentColor}20;" aria-hidden="true">${note.icon}</span>
        </a>
      </li>`;
    }

    function setActive(index: number): void {
      for (const li of visibleItems) {
        li.setAttribute("aria-selected", "false");
        const anchor = li.querySelector("a");
        if (anchor) anchor.classList.remove("bg-foreground/4");
      }

      activeIndex = index;

      if (index >= 0 && index < visibleItems.length) {
        const li = visibleItems[index];
        li.setAttribute("aria-selected", "true");
        const anchor = li.querySelector("a");
        if (anchor) anchor.classList.add("bg-foreground/4");
        input?.setAttribute("aria-activedescendant", li.id);
        li.scrollIntoView({ block: "nearest" });
      } else {
        input?.setAttribute("aria-activedescendant", "");
      }
    }

    function renderResults(notes: NoteItem[]): void {
      if (notes.length === 0) {
        list !== null && (list.innerHTML = "");
        if (emptyMsg) emptyMsg.classList.remove("hidden");
        visibleItems = [];
        setActive(-1);
        return;
      }

      if (emptyMsg) emptyMsg.classList.add("hidden");
      list !== null && (list.innerHTML = notes.map((n, i) => buildItemHTML(n, i)).join(""));
      visibleItems = Array.from(list?.querySelectorAll<HTMLLIElement>("li") || []);

      const newItems = list?.querySelectorAll<HTMLElement>(".search-modal-item") || [];
      gsap.set(newItems, { opacity: 0, y: 10 });
      gsap.to(newItems, {
        opacity: 1,
        y: 0,
        duration: 0.25,
        ease: "power2.out",
        stagger: 0.03
      });

      setActive(0);
    }

    function filterNotes(query: string): void {
      const q = query.trim();
      if (!q) {
        renderResults(allNotes);
        return;
      }
      const results = fuse.search(q).map((r) => r.item);
      renderResults(results);
    }

    function resetState(): void {
      if (input) {
        input.value = "";
        input.setAttribute("aria-expanded", "false");
      }
      activeIndex = -1;
      visibleItems = [];
    }

    function open(): void {
      if (isOpen) return;
      isOpen = true;
      document.body.style.overflow = "hidden";
      input?.setAttribute("aria-expanded", "true");

      renderResults(allNotes);

      gsap.killTweensOf([backdrop, panel, content]);
      gsap.set(backdrop, { autoAlpha: 0 });
      gsap.set(panel, { autoAlpha: 0 });
      gsap.set(content, { y: 40, scale: 0.97 });

      panel?.classList.remove("pointer-events-none");

      gsap.to(backdrop, { autoAlpha: 1, duration: 0.3, ease: "power2.out" });
      gsap.to(panel, { autoAlpha: 1, duration: 0.15, ease: "power1.out" });
      gsap.to(content, { y: 0, scale: 1, duration: 0.5, ease: "power3.out" });

      requestAnimationFrame(() => input?.focus());
    }

    function close(): void {
      if (!isOpen) return;
      isOpen = false;

      const currentItems = content?.querySelectorAll<HTMLElement>(".search-modal-item") || [];
      gsap.killTweensOf([backdrop, panel, content, ...Array.from(currentItems)]);

      gsap.to(currentItems, { opacity: 0, y: -6, duration: 0.15, ease: "power2.in", stagger: 0.02 });
      gsap.to(content, { y: -20, scale: 0.97, duration: 0.25, ease: "power2.in" });
      gsap.to(backdrop, { autoAlpha: 0, duration: 0.25, ease: "power2.in" });
      gsap.to(panel, {
        autoAlpha: 0,
        duration: 0.25,
        ease: "power2.in",
        onComplete: () => {
          panel?.classList.add("pointer-events-none");
          document.body.style.overflow = "";
          resetState();
        }
      });
    }

    document.addEventListener("click", (e: MouseEvent) => {
      const target = e.target as HTMLElement;
      if (target.closest('[data-toggle="search-modal"]')) {
        e.stopPropagation();
        isOpen ? close() : open();
        return;
      }
      if (isOpen && !content.contains(target)) {
        close();
      }
    }, { signal });

    backdrop.addEventListener("click", () => {
      if (isOpen) close();
    }, { signal });

    window.addEventListener("frankuxui:search-toggle", () => {
      isOpen ? close() : open();
    }, { signal });

    document.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "Escape" && isOpen) {
        e.preventDefault();
        close();
        return;
      }

      if (!isOpen) return;

      if (e.key === "ArrowDown") {
        e.preventDefault();
        if (visibleItems.length === 0) return;
        setActive(activeIndex < visibleItems.length - 1 ? activeIndex + 1 : 0);
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        if (visibleItems.length === 0) return;
        setActive(activeIndex > 0 ? activeIndex - 1 : visibleItems.length - 1);
      } else if (e.key === "Enter") {
        e.preventDefault();
        if (activeIndex >= 0 && activeIndex < visibleItems.length) {
          const anchor = visibleItems[activeIndex].querySelector<HTMLAnchorElement>("a");
          if (anchor) {
            close();
            window.location.href = anchor.href;
          }
        }
      }
    }, { signal });

    input.addEventListener("input", () => {
      filterNotes(input.value);
    }, { signal });

    content.addEventListener("click", (e: MouseEvent) => {
      if ((e.target as HTMLElement).closest("a")) close();
    }, { signal });

    list.addEventListener("mousemove", (e: MouseEvent) => {
      const li = (e.target as HTMLElement).closest<HTMLLIElement>("li[role='option']");
      if (!li) return;
      const idx = visibleItems.indexOf(li);
      if (idx !== -1 && idx !== activeIndex) setActive(idx);
    }, { signal });

    document.addEventListener("astro:before-swap", () => {
      if (isOpen) {
        isOpen = false;
        gsap.set([backdrop, panel], { autoAlpha: 0 });
        panel.classList.add("pointer-events-none");
        document.body.style.overflow = "";
        resetState();
      }
    }, { signal });
  }

  document.addEventListener("astro:page-load", initSearchModal);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initSearchModal);
  } else {
    initSearchModal();
  }
</script>
