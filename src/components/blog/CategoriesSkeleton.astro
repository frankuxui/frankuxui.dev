---
const placeholders = ["Todos", "Categoría", "Categoría", "Categoría", "Categoría"];
---

<nav class="flex w-full flex-wrap items-center gap-3" aria-hidden="true" aria-label="Cargando categorías">
  {
    placeholders.map((label, index) => (
      <span
        class="inline-flex h-10 animate-pulse items-center justify-center border-2 border-foreground/20 bg-foreground/5 px-5 text-sm uppercase text-transparent"
        style={{ width: `${5 + index * 1.5}rem` }}
      >
        {label}
      </span>
    ))
  }
</nav>
