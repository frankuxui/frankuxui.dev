---
const placeholders = Array.from({ length: 6 });
---

<div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3" aria-hidden="true" aria-label="Cargando artículos">
  {
    placeholders.map(() => (
      <div class="flex h-full flex-col border-2 border-foreground/15 bg-foreground/2">
        <div class="aspect-[16/10] w-full animate-pulse border-b-2 border-foreground/15 bg-foreground/5" />
        <div class="flex flex-1 flex-col gap-3 p-6">
          <div class="h-5 w-4/5 animate-pulse bg-foreground/10" />
          <div class="h-4 w-full animate-pulse bg-foreground/10" />
          <div class="h-4 w-2/3 animate-pulse bg-foreground/10" />
        </div>
      </div>
    ))
  }
</div>
