---
import type { BlogCategory } from "@/services/blogApiService";

interface Props {
  categories: BlogCategory[];
  activeCategory?: string | null;
}

const { categories, activeCategory = null } = Astro.props as Props;

function buildHref(slug: string | null) {
  if (!slug) return "/blog";
  return `/blog?category=${encodeURIComponent(slug)}`;
}

const chipClass =
  "inline-flex items-center gap-2 whitespace-nowrap uppercase justify-center font-medium px-5 h-10 text-sm transition-all duration-200 border-2 border-foreground shadow-[3px_3px_0px_var(--color-foreground)] hover:shadow-[1px_1px_0px_var(--color-foreground)] hover:translate-x-[2px] hover:translate-y-[2px]";
---

<nav class="flex w-full flex-wrap items-center gap-3" aria-label="Filtrar artículos por categoría">
  <a href={buildHref(null)} class:list={[chipClass, activeCategory ? "bg-background text-foreground hover:bg-foreground/5" : "bg-foreground text-background"]} aria-current={activeCategory ? undefined : "true"}>
    Todos
  </a>
  {
    categories.map((category) => {
      const isActive = activeCategory === category.slug;
      return (
        <a href={buildHref(category.slug)} class:list={[chipClass, isActive ? "bg-foreground text-background" : "bg-background text-foreground hover:bg-foreground/5"]} aria-current={isActive ? "true" : undefined}>
          {category.name}
          {typeof category.count === "number" && <span class="text-foreground/50 group-hover:text-background/70">({category.count})</span>}
        </a>
      );
    })
  }
</nav>
