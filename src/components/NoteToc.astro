---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props as Props;
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{
  tocHeadings.length > 0 && (
    <nav id="note-toc" class="note-toc" aria-label="Tabla de contenidos" data-note-toc>
      <div class="note-toc__lines" aria-hidden="true">
        {tocHeadings.map((h) => (
          <span class:list={["note-toc__tick", h.depth === 3 && "note-toc__tick--sub"]} />
        ))}
      </div>

      <div class="note-toc__panel">
        <p class="note-toc__label">En esta nota</p>
        <ol class="note-toc__list">
          {tocHeadings.map((h) => (
            <li>
              <a href={`#${h.slug}`} class:list={["note-toc__link", h.depth === 3 && "note-toc__link--sub"]} data-toc-link={h.slug}>
                {h.text}
              </a>
            </li>
          ))}
        </ol>
      </div>
    </nav>
  )
}

<style>
  .note-toc {
    position: fixed;
    right: 2rem;
    top: 50%;
    translate: 0 -50%;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 0;
  }

  .note-toc__lines {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
    padding: 10px 8px;
    cursor: pointer;
  }

  .note-toc__tick {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--foreground);
    opacity: 0.25;
    border-radius: 1px;
    transition:
      opacity 0.2s,
      background 0.2s,
      width 0.2s;
  }

  .note-toc__tick--sub {
    width: 12px;
  }

  .note-toc__tick.is-active {
    opacity: 1;
    background: var(--primary);
    width: 30px;
  }

  .note-toc__tick--sub.is-active {
    width: 16px;
  }

  .note-toc:hover .note-toc__tick,
  .note-toc:focus-within .note-toc__tick {
    opacity: 0.5;
  }

  .note-toc__panel {
    position: absolute;
    right: 100%;
    top: 50%;
    translate: 0 -50%;
    width: max-content;
    max-width: 320px;
    margin-right: -2px;
    max-height: 70dvh;
    overflow-y: auto;
    background: color-mix(in srgb, var(--background) 85%, transparent);
    backdrop-filter: blur(20px) saturate(1.2);
    -webkit-backdrop-filter: blur(20px) saturate(1.2);
    border: 1px solid color-mix(in srgb, var(--foreground) 8%, transparent);
    border-radius: 1rem;
    padding: 1rem 1.25rem;
    padding-right: calc(1.25rem + 16px);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.08),
      0 2px 8px rgba(0, 0, 0, 0.04);
    opacity: 0;
    pointer-events: none;
    scale: 0.96;
    translate: 8px -50%;
    transition:
      opacity 0.2s cubic-bezier(0.22, 1, 0.36, 1),
      scale 0.2s cubic-bezier(0.22, 1, 0.36, 1),
      translate 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .note-toc:hover .note-toc__panel,
  .note-toc:focus-within .note-toc__panel {
    opacity: 1;
    pointer-events: auto;
    scale: 1;
    translate: 0 -50%;
  }

  .note-toc__label {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--foreground);
    opacity: 0.4;
    margin-bottom: 0.625rem;
  }

  .note-toc__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .note-toc__link {
    display: block;
    font-size: 0.8125rem;
    line-height: 1.4;
    padding: 0.5rem 1rem;
    border-radius: 0.375rem;
    color: var(--foreground);
    opacity: 0.6;
    text-decoration: none;
    transition:
      opacity 0.15s,
      background 0.15s;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 280px;
  }

  .note-toc__link--sub {
    padding-left: 1.25rem;
    font-size: 0.75rem;
  }

  .note-toc__link:hover {
    opacity: 1;
    background: color-mix(in srgb, var(--foreground) 6%, transparent);
  }

  .note-toc__link.is-active {
    opacity: 1;
    color: var(--primary);
    font-weight: 500;
  }

  @media (max-width: 1440px) {
    .note-toc {
      display: none;
    }
  }
</style>

<script>
  function setupToc() {
    const nav = document.querySelector<HTMLElement>("[data-note-toc]");
    if (!nav) return;

    const links = nav.querySelectorAll<HTMLAnchorElement>("[data-toc-link]");
    const ticks = nav.querySelectorAll<HTMLSpanElement>(".note-toc__tick");
    if (!links.length) return;

    const slugs = Array.from(links).map((a) => a.dataset.tocLink!);
    let active = "";

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            active = entry.target.id;
          }
        }
        links.forEach((link, i) => {
          const isActive = link.dataset.tocLink === active;
          link.classList.toggle("is-active", isActive);
          ticks[i]?.classList.toggle("is-active", isActive);
        });
      },
      { rootMargin: "-80px 0px -60% 0px", threshold: 0 }
    );

    slugs.forEach((slug) => {
      const el = document.getElementById(slug);
      if (el) observer.observe(el);
    });

    links.forEach((link) => {
      link.addEventListener("click", (e) => {
        e.preventDefault();
        const id = link.dataset.tocLink!;
        const target = document.getElementById(id);
        if (target) {
          target.scrollIntoView({ behavior: "smooth", block: "start" });
          history.replaceState(null, "", `#${id}`);
        }
      });
    });

    return () => observer.disconnect();
  }

  let cleanup: (() => void) | undefined;

  function init() {
    cleanup?.();
    cleanup = setupToc() ?? undefined;
  }

  document.addEventListener("astro:page-load", init);
</script>
