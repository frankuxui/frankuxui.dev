---
import type { StrapiMission } from "@/types/StrapiMission";

const { strapiCollection } = Astro.props as {
  strapiCollection: StrapiMission;
};

const { title, subtitle, cover } = strapiCollection as StrapiMission;

// Generar id accesible único
const labelId = `valor-${title.toLowerCase().replace(/\s+/g, "-")}`;
---

<article role="region" aria-labelledby={labelId} title={cover.caption} class="w-full h-full flex col-span-4 group relative gap-4 overflow-hidden rounded-2xl">
  <header class="relative w-full h-full">
    <div
      class="absolute z-1 w-full gap-2 h-full inset-0 left-0 flex items-start flex-col justify-end p-6 sm:p-8 bg-gradient-to-t from-black via-black/20 text-white to-transparent"
    >
      <h3 id={labelId} class="text-xl font-medium">{title}</h3>
      <p class="text-base">{subtitle}</p>
    </div>

    {
      cover?.url == null ? (
        <div class="w-full h-full max-h-full min-h-0 z-0 max-w-full bg-foreground/5 object-cover aspect-[6/9] animate-pulse" />
      ) : (
        <img
          src={cover.url}
          alt={cover.alternativeText}
          class="w-full h-full max-h-full z-0 max-w-full object-cover aspect-[6/9] min-h-80"
          title={cover.caption}
          data-author-profile={cover.authorUrl}
          loading="lazy"
          decoding="async"
        />
      )
    }
  </header>
</article>
