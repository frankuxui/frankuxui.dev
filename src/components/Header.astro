---
import Logo from "@/components/Logo.astro";
import MobileMenuToggle from "@/components/MobileMenuToggle.astro";
const pathname = Astro.url.pathname;
---

<header class="sticky top-0 left-0 w-full h-20 sm:h-24 flex items-center justify-center z-50 duration-300 border-b-2 border-border bg-background/70 backdrop-blur-2xl" data-toggle="header">
  <div class="w-full max-w-7xl 3xl:max-w-8xl mx-auto px-10">
    <div class="w-full relative flex items-center">
      <div class="header-inner flex items-center w-full h-full">
        <nav class="flex items-center justify-between w-full gap-8">
          <div class="mr-auto flex-1">
            <Logo />
          </div>
          <ul class="hidden md:flex flex-none items-center justify-center mx-auto gap-2" role="list">
            {
              [
                { href: "/sobre-mi", label: "Sobre mi" },
                { href: "/contacto", label: "Contacto" }
              ].map(({ href, label }) => (
                <li role="listitem">
                  <a
                    href={href}
                    data-toggle="header-link"
                    class:list={[
                      "inline-flex items-center uppercase justify-center font-medium px-6 h-10 text-sm transition-all duration-300 hover:bg-foreground/5 data-[state='active']:bg-foreground data-[state='active']:text-background border-2 border-foreground shadow-[4px_4px_0px_var(--color-foreground)] hover:shadow-[2px_2px_0px_var(--color-foreground)] transform-[translate(2px,_2px)]",
                      {
                        "bg-foreground text-background": pathname.includes(href)
                      }
                    ]}
                    data-state={pathname.includes(href) ? "active" : ""}
                    aria-current={pathname.includes(href) ? "page" : undefined}
                    data-astro-reload
                  >
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>

          <div class="ml-auto flex flex-1 items-center justify-end gap-4">
            <button
              class="inline-flex flex-none size-12 items-center justify-center cursor-pointer hover:bg-foreground/6 motion-safe:transition-all duration-200"
              type="button"
              data-toggle="palette-modal"
              aria-label="Cambiar tema de la web"
              aria-haspopup="dialog"
              aria-controls="palette-modal"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="size-6" viewBox="0 0 24 24">
                <path d="M0 0h24v24H0z" fill="none"></path>
                <path
                  fill="currentColor"
                  d="M12 22q-2.05 0-3.875-.788t-3.187-2.15t-2.15-3.187T2 12q0-2.075.813-3.9t2.2-3.175T8.25 2.788T12.2 2q2 0 3.775.688t3.113 1.9t2.125 2.875T22 11.05q0 2.875-1.75 4.413T16 17h-1.85q-.225 0-.312.125t-.088.275q0 .3.375.863t.375 1.287q0 1.25-.687 1.85T12 22m-4.425-9.425Q8 12.15 8 11.5t-.425-1.075T6.5 10t-1.075.425T5 11.5t.425 1.075T6.5 13t1.075-.425m3-4Q11 8.15 11 7.5t-.425-1.075T9.5 6t-1.075.425T8 7.5t.425 1.075T9.5 9t1.075-.425m5 0Q16 8.15 16 7.5t-.425-1.075T14.5 6t-1.075.425T13 7.5t.425 1.075T14.5 9t1.075-.425m3 4Q19 12.15 19 11.5t-.425-1.075T17.5 10t-1.075.425T16 11.5t.425 1.075T17.5 13t1.075-.425M12 20q.225 0 .363-.125t.137-.325q0-.35-.375-.825T11.75 17.3q0-1.05.725-1.675T14.25 15H16q1.65 0 2.825-.962T20 11.05q0-3.025-2.312-5.038T12.2 4Q8.8 4 6.4 6.325T4 12q0 3.325 2.338 5.663T12 20"
                ></path>
              </svg>
            </button>
            <MobileMenuToggle />
          </div>
        </nav>
      </div>
    </div>
  </div>
</header>

<script>
  (function () {
    let header: HTMLDivElement | null = null;
    let lastScroll = 0;
    let ticking = false;
    const threshold = 80;
    const tolerance = 5;

    function onScroll() {
      const currentScroll = window.scrollY;
      const delta = currentScroll - lastScroll;

      if (Math.abs(delta) < tolerance) return;

      if (currentScroll > threshold && delta > 0) {
        if (header) header.style.transform = "translateY(-100%)";
      } else {
        if (header) header.style.transform = "translateY(0)";
      }

      lastScroll = currentScroll;
    }

    function scrollHandler() {
      if (!ticking) {
        requestAnimationFrame(() => {
          onScroll();
          ticking = false;
        });
        ticking = true;
      }
    }

    function setup() {
      header = document.querySelector("[data-toggle='header']") as HTMLDivElement;
      if (!header) return;

      // Reiniciamos posición
      header.style.transform = "translateY(0)";
      lastScroll = window.scrollY;

      // Quitamos listeners anteriores por si acaso (prevención si Astro rehidrata)
      window.removeEventListener("scroll", scrollHandler);
      window.addEventListener("scroll", scrollHandler, { passive: true });
    }

    // Setup inicial
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setup);
    } else {
      setup();
    }

    document.addEventListener("DOMContentLoaded", setup);
  })();

  // Header links

  function updateActiveLinks() {
    const headerLinks = document.querySelectorAll("[data-toggle='header-link']") as NodeListOf<HTMLAnchorElement>;
    const currentPath = window.location.pathname.replace(/\/+$/, "") || "/";

    headerLinks.forEach((link) => {
      const href = (link.getAttribute("href") ?? "").replace(/\/+$/, "") || "/";
      if (href === "/" && currentPath === "/") {
        link.setAttribute("data-state", "active");
      } else if (href !== "/" && (currentPath === href || currentPath.startsWith(href + "/"))) {
        link.setAttribute("data-state", "active");
      } else {
        link.removeAttribute("data-state");
      }
    });
  }

  function setupActiveLinkHandler() {
    updateActiveLinks();
    document.addEventListener("DOMContentLoaded", updateActiveLinks);
  }

  // Ejecutamos cuando el DOM esté listo
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupActiveLinkHandler);
  } else {
    setupActiveLinkHandler();
  }
</script>

<style>
  [data-toggle="header"] {
    transition: transform 0.2s ease-in-out;
  }
</style>
