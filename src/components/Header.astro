---
import Logo from "@/components/Logo.astro";
import MobileMenuToggle from "@/components/MobileMenuToggle.astro";
const pathname = Astro.url.pathname;
---

<header class="fixed top-0 left-0 w-full h-24 sm:h-28 flex items-center justify-center z-50" data-toggle="header" transition:persist>
  <div class="w-full max-w-12xl mx-auto px-10" data-header-container>
    <nav class="flex items-center justify-between w-full gap-8">
      <div class="mr-auto flex-1">
        <Logo class="header-logo" />
      </div>

      <ul class="header-nav hidden md:flex relative flex-none items-center justify-center mx-auto gap-0 xl:gap-2 rounded-full p-3 xl:p-4 transition-all duration-300 backdrop-blur-xl" role="list">
        <li class="header-indicator absolute rounded-full transition-all duration-300 ease-out" aria-hidden="true"></li>
        <li role="listitem">
          <button
            type="button"
            data-toggle="search-modal"
            class="header-search relative z-10 inline-flex items-center justify-center font-medium px-3 h-9 text-sm rounded-lg transition-colors duration-300 cursor-pointer select-none"
            aria-label="Buscar notas (Ctrl + K)"
            title="Ctrl + K"
          >
            <span class="font-mono tracking-tight font-semibold text-xs">Ctrl + K</span>
          </button>
        </li>
        {
          [
            { href: "/", label: "Inicio" },
            { href: "/sobre-mi", label: "Sobre mi" },
            { href: "/biografia", label: "Biografía" },
            { href: "/notas", label: "Notas" }
          ].map(({ href, label }) => (
            <li role="listitem">
              <a
                href={href}
                data-toggle="header-link"
                class="header-link relative z-10 inline-flex items-center justify-center font-normal px-4 xl:px-6 h-10 xl:h-11 text-sm xl:text-base rounded-full transition-colors duration-300"
                data-state={pathname === href || (href !== "/" && pathname.startsWith(href)) ? "active" : ""}
                aria-current={pathname === href || (href !== "/" && pathname.startsWith(href)) ? "page" : undefined}
              >
                {label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href="/contacto"
            class="header-link relative z-10 inline-flex items-center justify-center font-normal px-4 xl:px-6 h-10 xl:h-11 text-sm xl:text-base rounded-full transition-colors duration-300"
            data-toggle="header-link"
            data-state={pathname === "/contacto" ? "active" : ""}
            aria-current={pathname === "/contacto" ? "page" : undefined}
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24">
              <path d="M0 0h24v24H0z" fill="none"></path>
              <g fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="2">
                <path stroke-linecap="round" d="m7 8.5l2.942 1.74c1.715 1.014 2.4 1.014 4.116 0L17 8.5"></path>
                <path
                  d="M2.016 13.476c.065 3.065.098 4.598 1.229 5.733c1.131 1.136 2.705 1.175 5.854 1.254c1.94.05 3.862.05 5.802 0c3.149-.079 4.723-.118 5.854-1.254c1.131-1.135 1.164-2.668 1.23-5.733c.02-.986.02-1.966 0-2.952c-.066-3.065-.099-4.598-1.23-5.733c-1.131-1.136-2.705-1.175-5.854-1.254a115 115 0 0 0-5.802 0c-3.149.079-4.723.118-5.854 1.254c-1.131 1.135-1.164 2.668-1.23 5.733a69 69 0 0 0 0 2.952Z"
                ></path>
              </g>
            </svg>
          </a>
        </li>
      </ul>

      <div class="ml-auto flex flex-1 items-center justify-end gap-2">
        <button
          class="header-palette-toggle inline-flex flex-none size-12 items-center justify-center cursor-pointer rounded-full transition-colors duration-200"
          type="button"
          data-toggle="palette-modal"
          aria-label="Cambiar tema de la web"
          aria-haspopup="dialog"
          aria-controls="palette-modal"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M0 0h24v24H0z" fill="none"></path>
            <path
              fill="currentColor"
              d="M12 22q-2.05 0-3.875-.788t-3.187-2.15t-2.15-3.187T2 12q0-2.075.813-3.9t2.2-3.175T8.25 2.788T12.2 2q2 0 3.775.688t3.113 1.9t2.125 2.875T22 11.05q0 2.875-1.75 4.413T16 17h-1.85q-.225 0-.312.125t-.088.275q0 .3.375.863t.375 1.287q0 1.25-.687 1.85T12 22m-4.425-9.425Q8 12.15 8 11.5t-.425-1.075T6.5 10t-1.075.425T5 11.5t.425 1.075T6.5 13t1.075-.425m3-4Q11 8.15 11 7.5t-.425-1.075T9.5 6t-1.075.425T8 7.5t.425 1.075T9.5 9t1.075-.425m5 0Q16 8.15 16 7.5t-.425-1.075T14.5 6t-1.075.425T13 7.5t.425 1.075T14.5 9t1.075-.425m3 4Q19 12.15 19 11.5t-.425-1.075T17.5 10t-1.075.425T16 11.5t.425 1.075T17.5 13t1.075-.425M12 20q.225 0 .363-.125t.137-.325q0-.35-.375-.825T11.75 17.3q0-1.05.725-1.675T14.25 15H16q1.65 0 2.825-.962T20 11.05q0-3.025-2.312-5.038T12.2 4Q8.8 4 6.4 6.325T4 12q0 3.325 2.338 5.663T12 20"
            ></path>
          </svg>
        </button>
        <MobileMenuToggle />
      </div>
    </nav>
  </div>
</header>

<script>
  type HeaderWindow = Window & {
    __headerCleanup?: () => void;
    __headerPageLoadHandler?: () => void;
    __headerAfterSwapHandler?: () => void;
  };

  const headerWindow = window as HeaderWindow;

  function positionIndicator() {
    const nav = document.querySelector(".header-nav");
    const indicator = document.querySelector(".header-indicator") as HTMLElement;
    if (!nav || !indicator) return;

    const activeLink = nav.querySelector('a[data-state="active"]') as HTMLElement;
    if (!activeLink) {
      indicator.style.opacity = "0";
      return;
    }

    const navRect = nav.getBoundingClientRect();
    const linkRect = activeLink.getBoundingClientRect();

    indicator.style.left = `${linkRect.left - navRect.left}px`;
    indicator.style.top = `${linkRect.top - navRect.top}px`;
    indicator.style.width = `${linkRect.width}px`;
    indicator.style.height = `${linkRect.height}px`;
    indicator.style.opacity = "1";
  }

  function updateActiveLinks() {
    const links = document.querySelectorAll("[data-toggle='header-link']") as NodeListOf<HTMLAnchorElement>;
    const currentPath = window.location.pathname.replace(/\/+$/, "") || "/";

    links.forEach((link) => {
      const href = (link.getAttribute("href") ?? "").replace(/\/+$/, "") || "/";
      const isActive = href === "/" ? currentPath === "/" : currentPath === href || currentPath.startsWith(href + "/");

      if (isActive) {
        link.setAttribute("data-state", "active");
        link.setAttribute("aria-current", "page");
      } else {
        link.removeAttribute("data-state");
        link.removeAttribute("aria-current");
      }
    });

    positionIndicator();
  }

  function onScroll() {
    const nav = document.querySelector(".header-nav");
    if (!nav) return;
    if (window.scrollY > 10) {
      nav.classList.add("nav-scrolled");
    } else {
      nav.classList.remove("nav-scrolled");
    }
  }

  function resolveInset(value: string, size: number) {
    const parsed = Number.parseFloat(value);
    if (!Number.isFinite(parsed)) return 0;
    return value.endsWith("%") ? (parsed / 100) * size : parsed;
  }

  function coversHeaderEdge(section: HTMLElement, probeX: number, probeY: number) {
    const styles = getComputedStyle(section);
    if (styles.display === "none" || styles.visibility === "hidden" || Number.parseFloat(styles.opacity) === 0) return false;

    const rect = section.getBoundingClientRect();
    let visibleTop = rect.top;
    const topInset = styles.clipPath.match(/^inset\(\s*(-?\d*\.?\d+(?:e[-+]?\d+)?(?:%|px)?)/i)?.[1];
    if (topInset) visibleTop += resolveInset(topInset, rect.height);

    return probeX >= rect.left && probeX <= rect.right && probeY >= visibleTop && probeY <= rect.bottom;
  }

  function updateHeaderContrast() {
    const header = document.querySelector('[data-toggle="header"]') as HTMLElement | null;
    if (!header) return;

    const headerRect = header.getBoundingClientRect();
    const probeX = headerRect.left + headerRect.width / 2;
    const probeY = Math.max(headerRect.top, headerRect.bottom - 1);
    const darkSections = Array.from(document.querySelectorAll('[data-header-contrast="dark"]'));
    const coverage = darkSections.map((section) => coversHeaderEdge(section as HTMLElement, probeX, probeY));
    const hasDarkSurface = coverage.some(Boolean);

    if (hasDarkSurface) header.setAttribute("data-contrast", "dark");
    else header.removeAttribute("data-contrast");
  }

  function setup() {
    headerWindow.__headerCleanup?.();
    updateActiveLinks();
    onScroll();
    updateHeaderContrast();

    let ticking = false;
    const scheduleUpdate = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        onScroll();
        updateHeaderContrast();
        // ScrollTrigger writes transforms and clip-paths on its own animation frame.
        // Re-read once after that paint so the header sees the rendered surface.
        requestAnimationFrame(() => {
          updateHeaderContrast();
          ticking = false;
        });
      });
    };

    window.addEventListener("scroll", scheduleUpdate, { passive: true });
    window.addEventListener("resize", scheduleUpdate, { passive: true });
    const contrastObserver = new MutationObserver(scheduleUpdate);
    document.querySelectorAll('[data-header-contrast="dark"]').forEach((section) =>
      contrastObserver.observe(section, { attributes: true, attributeFilter: ["class", "style"] })
    );
    headerWindow.__headerCleanup = () => {
      window.removeEventListener("scroll", scheduleUpdate);
      window.removeEventListener("resize", scheduleUpdate);
      contrastObserver.disconnect();
    };
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setup);
  } else {
    setup();
  }

  if (headerWindow.__headerPageLoadHandler) document.removeEventListener("astro:page-load", headerWindow.__headerPageLoadHandler);
  if (headerWindow.__headerAfterSwapHandler) document.removeEventListener("astro:after-swap", headerWindow.__headerAfterSwapHandler);

  headerWindow.__headerPageLoadHandler = setup;
  headerWindow.__headerAfterSwapHandler = () => {
    updateActiveLinks();
    updateHeaderContrast();
  };

  document.addEventListener("astro:page-load", headerWindow.__headerPageLoadHandler);
  document.addEventListener("astro:after-swap", headerWindow.__headerAfterSwapHandler);
</script>
